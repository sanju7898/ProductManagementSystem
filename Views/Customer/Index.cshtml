@model IEnumerable<ProductManagementSystem.Models.Customer>

@{
    ViewData["Title"] = "Customer Management";

    var totalCustomers = Model?.Count() ?? 0;
    var activeCustomers = Model?.Count(x => x.IsActive) ?? 0;
    var inactiveCustomers = Model?.Count(x => !x.IsActive) ?? 0;
}

<style>
    .customer-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .customer-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* =========================
           WORLD-CLASS HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-logo-box {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
        border: 1px solid #1d4ed8;
    }

    /* Top Breadcrumb with Dashboard Link */
    .breadcrumb-text {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .dashboard-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #38bdf8;
        text-decoration: none;
        font-weight: bold;
        background: #334155;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #475569;
        transition: all 0.2s;
    }

        .dashboard-link:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #1d4ed8;
            text-decoration: none;
        }

    .breadcrumb-text span {
        color: #64748b;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-heading {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 4px;
        background: #334155;
        border: 1px solid #475569;
        color: #38bdf8;
        font-size: 12px;
        font-weight: bold;
    }

    .page-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .add-customer-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 48px;
        padding: 0 24px;
        border-radius: 6px;
        background: #2563eb;
        border: 1px solid #1d4ed8;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: background 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.2);
    }

        .add-customer-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================
           EXECUTIVE SUMMARY CARDS
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #334155;
        border-radius: 8px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        transition: transform 0.2s;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.06);
        }

        .summary-card.summary-total {
            border-top-color: #2563eb;
        }

        .summary-card.summary-active {
            border-top-color: #059669;
        }

        .summary-card.summary-inactive {
            border-top-color: #dc2626;
        }

    .summary-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 24px;
    }

    .summary-total .summary-icon {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .summary-active .summary-icon {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .summary-inactive .summary-icon {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .summary-content span {
        display: block;
        color: #1e293b;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 0.3px;
    }

    .summary-content small {
        display: block;
        color: #64748b;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .summary-content strong {
        display: block;
        font-size: 28px;
        font-family: 'Georgia', serif;
        margin-top: 2px;
    }

    .summary-total strong {
        color: #2563eb;
    }

    .summary-active strong {
        color: #059669;
    }

    .summary-inactive strong {
        color: #dc2626;
    }

    /* =========================
           SEARCH CARD
           ========================= */

    .content-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
        margin-bottom: 28px;
    }

    .search-card {
        padding: 22px 28px;
    }

    .search-form {
        display: flex;
        align-items: flex-end;
        gap: 15px;
    }

    .search-field {
        flex: 1;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: bold;
        color: #334155;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .search-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
    }

        .search-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    .search-actions {
        display: flex;
        gap: 10px;
    }

    .search-btn,
    .clear-btn {
        height: 46px;
        padding: 0 22px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .search-btn {
        background: #2563eb;
        color: #ffffff;
        border: 1px solid #1d4ed8;
    }

        .search-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
        }

    .clear-btn {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde047;
    }

        .clear-btn:hover {
            background: #fef3c7;
            color: #92400e;
            text-decoration: none;
        }

    /* =========================
           TABLE HEADER
           ========================= */

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
    }

    .registry-title-area h4 {
        margin: 0 0 4px;
        color: #1e3a8a;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .registry-title-icon {
        width: 36px;
        height: 36px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);
    }

    .registry-title-area p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .record-count {
        padding: 8px 16px;
        border-radius: 6px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #bfdbfe;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.08);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .customer-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 1100px;
    }

        .customer-table thead th {
            background: #334155;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 2px solid #1e293b;
            white-space: nowrap;
        }

        .customer-table tbody td {
            padding: 18px 20px;
            font-size: 14px;
            color: #1e293b;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .customer-table tbody tr:hover {
            background: #f8fafc;
        }

    .customer-number {
        color: #64748b;
        font-weight: bold;
        font-size: 14px;
    }

    .customer-name-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .customer-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        font-size: 16px;
        border: 1px solid #bfdbfe;
    }

    .customer-name {
        color: #0f172a;
        font-weight: bold;
        font-size: 15px;
    }

    .customer-phone,
    .customer-email,
    .created-date {
        color: #475569;
        font-size: 14px;
    }

    /* STATUS BADGES */
    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        border: 1px solid transparent;
    }

    .status-active {
        color: #065f46;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .status-inactive {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* ACTIONS */
    .actions {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .action-btn {
        padding: 7px 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid transparent;
        transition: opacity 0.2s;
    }

        .action-btn:hover {
            opacity: 0.85;
            text-decoration: none;
        }

    .view-btn {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .edit-btn {
        background: #fef9c3;
        color: #854d0e;
        border-color: #fde047;
    }

    .delete-btn {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fca5a5;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 26px;
        border: 1px solid #fecaca;
    }

    .empty-state h5 {
        color: #1e293b;
        font-family: 'Georgia', serif;
        margin: 0 0 8px;
        font-size: 18px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 14px;
        margin: 0 0 20px;
    }

    .empty-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 42px;
        padding: 0 20px;
        border-radius: 6px;
        background: #2563eb;
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #1d4ed8;
    }

        .empty-add-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================
           RAZOR SAFE MEDIA QUERY (@@media)
           ========================= */

    @@media screen and (max-width: 900px) {
        .customer-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .search-actions {
            width: 100%;
        }

        .search-btn, .clear-btn {
            flex: 1;
        }
    }
</style>

<div class="customer-page">
    <div class="customer-container">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="header-left">
                <div class="header-logo-box">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <!-- Top Breadcrumb with Dashboard Button -->
                    <div class="breadcrumb-text">
                        <a href="@Url.Action("Index", "Dashboard")" class="dashboard-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <span>/</span> Customer Management
                    </div>
                    <div class="title-row">
                        <h1 class="page-heading">Customer Management</h1>
                        <span class="header-badge">
                            <i class="bi bi-shield-check"></i> Admin
                        </span>
                    </div>
                    <p class="page-description">Maintain and verify customer registry details efficiently</p>
                </div>
            </div>

            <a href="@Url.Action("Create", "Customer")" class="add-customer-btn">
                <i class="bi bi-person-plus-fill"></i>
                <span>Add Customer</span>
            </a>
        </div>

        <!-- SUMMARY CARDS WITH COLORFUL NUMBERS -->
        <div class="summary-grid">
            <div class="summary-card summary-total">
                <div class="summary-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="summary-content">
                    <small>All Registry Records</small>
                    <span>Total Customers</span>
                    <strong>@totalCustomers</strong>
                </div>
            </div>

            <div class="summary-card summary-active">
                <div class="summary-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div class="summary-content">
                    <small>Verified Active</small>
                    <span>Active Customers</span>
                    <strong>@activeCustomers</strong>
                </div>
            </div>

            <div class="summary-card summary-inactive">
                <div class="summary-icon">
                    <i class="bi bi-person-x-fill"></i>
                </div>
                <div class="summary-content">
                    <small>Suspended / Inactive</small>
                    <span>Inactive Customers</span>
                    <strong>@inactiveCustomers</strong>
                </div>
            </div>
        </div>

        <!-- SEARCH CARD -->
        <div class="content-card search-card">
            <form action="@Url.Action("Index", "Customer")" method="get">
                <div class="search-form">
                    <div class="search-field">
                        <label class="form-label">Search Records</label>
                        <input type="text"
                               name="SearchString"
                               value="@ViewBag.SearchString"
                               class="search-input"
                               placeholder="Filter by customer name, telephone or email..." />
                    </div>
                    <div class="search-actions">
                        <button type="submit" class="search-btn">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a href="@Url.Action("Index", "Customer")" class="clear-btn">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- CUSTOMER RECORDS TABLE -->
        <div class="content-card table-card">
            <div class="table-header">
                <div class="registry-title-area">
                    <h4>
                        <span class="registry-title-icon"><i class="bi bi-folder2-open"></i></span>
                        Registry Records
                    </h4>
                    <p>Complete official directory of registered customers</p>
                </div>
                <span class="record-count">
                    <i class="bi bi-database-fill me-1"></i> @totalCustomers @(totalCustomers == 1 ? "Record" : "Records")
                </span>
            </div>

            <div class="table-responsive">
                <table class="customer-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer Details</th>
                            <th>Telephone</th>
                            <th>Email Address</th>
                            <th>Status</th>
                            <th>Registration Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="customer-number">@count</span>
                                    </td>
                                    <td>
                                        <div class="customer-name-wrapper">
                                            <div class="customer-icon">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <span class="customer-name">@item.CustomerName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="customer-phone">
                                            <i class="bi bi-telephone-fill me-1 text-secondary"></i> @item.Phone
                                        </span>
                                    </td>
                                    <td>
                                        <span class="customer-email">
                                            <i class="bi bi-envelope-fill me-1 text-secondary"></i>
                                            @(string.IsNullOrWhiteSpace(item.Email) ? "No email provided" : item.Email)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status status-active">
                                                <span class="status-dot"></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status status-inactive">
                                                <span class="status-dot"></span> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="created-date">@item.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a href="@Url.Action("Details", "Customer", new { id = item.CustomerId })" class="action-btn view-btn" title="View Details">
                                                <i class="bi bi-eye-fill"></i> <span>View</span>
                                            </a>
                                            <a href="@Url.Action("Edit", "Customer", new { id = item.CustomerId })" class="action-btn edit-btn" title="Edit Customer">
                                                <i class="bi bi-pencil-square"></i> <span>Edit</span>
                                            </a>
                                            <a href="@Url.Action("Delete", "Customer", new { id = item.CustomerId })" class="action-btn delete-btn" title="Delete Customer">
                                                <i class="bi bi-trash-fill"></i> <span>Delete</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="bi bi-person-x-fill"></i>
                                        </div>
                                        <h5>No Records Found</h5>
                                        <p>There are no customer accounts matching your filter criteria.</p>
                                        <a href="@Url.Action("Create", "Customer")" class="empty-add-btn">
                                            <i class="bi bi-person-plus-fill"></i> Register New Customer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>