@model ProductManagementSystem.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<style>
    .customer-delete-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .customer-delete-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .delete-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .delete-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .delete-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #dc2626; /* Red for Delete */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(220, 38, 38, 0.4);
        border: 1px solid #b91c1c;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .delete-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .delete-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           FORM CARD WITH RED TOP ACCENT
           ========================= */

    .delete-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #dc2626;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* WARNING BOX */
    .warning-box {
        margin: 28px;
        padding: 20px 24px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .warning-icon {
        color: #dc2626;
        font-size: 22px;
        margin-top: 2px;
    }

    .warning-content strong {
        display: block;
        color: #991b1b;
        font-size: 15px;
        font-family: 'Georgia', serif;
        margin-bottom: 4px;
    }

    .warning-content p {
        margin: 0;
        color: #b91c1c;
        font-size: 13px;
        line-height: 1.5;
        font-weight: 500;
    }

    .details-body {
        padding: 0 28px 32px;
    }

    .customer-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        margin-bottom: 24px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .customer-avatar {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fef2f2;
        color: #dc2626;
        font-size: 24px;
        border: 1px solid #fecaca;
    }

    .customer-profile-info h3 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .customer-profile-info p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        font-weight: bold;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .detail-item {
        padding: 18px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .detail-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .detail-label i {
            color: #dc2626;
            font-size: 14px;
        }

    .detail-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: bold;
        word-break: break-word;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .cancel-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .delete-btn {
        background: #dc2626;
        color: #ffffff;
        border-color: #b91c1c;
        box-shadow: 0 3px 8px rgba(220, 38, 38, 0.25);
    }

        .delete-btn:hover {
            background: #b91c1c;
            border-color: #991b1b;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .customer-delete-page {
            padding: 15px;
        }

        .delete-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .customer-profile {
            align-items: flex-start;
        }

        .warning-box {
            margin: 20px;
        }

        .details-body {
            padding: 0 20px 25px;
        }
    }
</style>

<div class="customer-delete-page">
    <div class="customer-delete-container">

        <!-- Header -->
        <div class="delete-header">
            <div class="delete-header-left">
                <div class="delete-header-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Customer Management <span>/</span> Delete
                    </div>
                    <h1 class="delete-title">Delete Customer</h1>
                    <p class="delete-description">Review customer information securely before permanent deletion.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Customer")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Customers
            </a>
        </div>

        <!-- Delete Card -->
        <div class="delete-card">

            <!-- Warning -->
            <div class="warning-box">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="warning-content">
                    <strong>Are you sure you want to delete this customer?</strong>
                    <p>This action is irreversible. The customer account and all associated registry records will be permanently removed from the system.</p>
                </div>
            </div>

            <div class="details-body">

                <!-- Customer Profile -->
                <div class="customer-profile">
                    <div class="customer-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="customer-profile-info">
                        <h3>@Model.CustomerName</h3>
                        <p>Customer ID: #@Model.CustomerId</p>
                    </div>
                </div>

                <!-- Customer Details -->
                <div class="details-grid">

                    <!-- Customer Name -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-person"></i> Customer Name
                        </div>
                        <div class="detail-value">
                            @Model.CustomerName
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-telephone"></i> Phone Number
                        </div>
                        <div class="detail-value">
                            @Model.Phone
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-envelope"></i> Email Address
                        </div>
                        <div class="detail-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                @Model.Email
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-toggle-on"></i> Account Status
                        </div>
                        <div class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="text-success">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    <i class="bi bi-x-circle-fill me-1"></i> Inactive
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Created Date -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-calendar3"></i> Registration Date
                        </div>
                        <div class="detail-value">
                            @Model.CreatedDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <!-- Customer ID -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-hash"></i> Customer ID
                        </div>
                        <div class="detail-value">
                            #@Model.CustomerId
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="action-buttons">
                    <a href="@Url.Action("Index", "Customer")" class="btn-custom cancel-btn">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>

                    <form asp-action="Delete" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CustomerId" />
                        <button type="submit" class="btn-custom delete-btn" onclick="return confirm('Are you sure you want to permanently delete this customer record?');">
                            <i class="bi bi-trash3-fill"></i> Delete Customer
                        </button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</div>