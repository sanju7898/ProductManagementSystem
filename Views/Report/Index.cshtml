@{
    ViewData["Title"] = "Reports Dashboard";
}

<style>
    .report-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .report-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* =========================
           WORLD-CLASS HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-logo-box {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
        border: 1px solid #1d4ed8;
    }

    /* Top Breadcrumb with Dashboard Link */
    .breadcrumb-text {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .dashboard-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #38bdf8;
        text-decoration: none;
        font-weight: bold;
        background: #334155;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #475569;
        transition: all 0.2s;
    }

        .dashboard-link:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #1d4ed8;
            text-decoration: none;
        }

    .breadcrumb-text span {
        color: #64748b;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-heading {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 4px;
        background: #334155;
        border: 1px solid #475569;
        color: #38bdf8;
        font-size: 12px;
        font-weight: bold;
    }

    .page-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* =========================
           SECTION TITLES & GRIDS
           ========================= */

    .section-title {
        font-size: 18px;
        font-weight: bold;
        color: #1e3a8a;
        margin: 32px 0 16px;
        font-family: 'Georgia', serif;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 2px solid #cbd5e1;
        padding-bottom: 8px;
    }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .report-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 22px;
        text-decoration: none;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        transition: all 0.2s;
        border-top: 4px solid #334155;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .report-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            border-color: #2563eb;
            text-decoration: none;
        }

    .card-label {
        font-size: 12px;
        color: #64748b;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-value {
        font-size: 26px;
        font-weight: bold;
        color: #0f172a;
        margin-top: 10px;
        font-family: 'Georgia', serif;
    }

    .card-link {
        margin-top: 14px;
        font-size: 12px;
        color: #2563eb;
        font-weight: bold;
        border-top: 1px solid #f1f5f9;
        padding-top: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sales-value {
        color: #059669 !important;
    }

    .low-stock {
        color: #dc2626 !important;
    }

    /* DETAILED ACTIONS GRID */
    .report-actions {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 18px;
        margin-top: 20px;
    }

    .action-card {
        background: #ffffff;
        padding: 22px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #2563eb;
        text-decoration: none;
        color: #1e293b;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        font-weight: bold;
        text-align: center;
        transition: all 0.2s;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .action-card:hover {
            transform: translateY(-2px);
            color: #2563eb;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            text-decoration: none;
        }

    .action-description {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 500;
        margin-top: 6px;
    }

    /* =========================
           RAZOR SAFE MEDIA QUERY
           ========================= */

    @@media(max-width:1200px) {
        .report-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .report-actions {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media(max-width:768px) {
        .report-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .report-grid, .report-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="report-page">
    <div class="report-container">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="header-left">
                <div class="header-logo-box">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                </div>
                <div>
                    <!-- Top Breadcrumb with Dashboard Button -->
                    <div class="breadcrumb-text">
                        <a href="@Url.Action("Index", "Dashboard")" class="dashboard-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <span>/</span> Reports Analytics
                    </div>
                    <div class="title-row">
                        <h1 class="page-heading">Reports Dashboard</h1>
                        <span class="header-badge">
                            <i class="bi bi-shield-check"></i> Admin
                        </span>
                    </div>
                    <p class="page-description">Comprehensive analytics overview of products, customers, vendors, orders, and sales</p>
                </div>
            </div>
        </div>

        <!-- Product Report -->
        <div class="section-title">
            <i class="bi bi-box-seam"></i> Product & Inventory Report
        </div>

        <div class="report-grid">
            <a asp-action="StockReport" class="report-card" style="border-top-color: #2563eb;">
                <div class="card-label">Total Products</div>
                <div class="card-value" style="color: #2563eb;">@ViewBag.TotalProducts</div>
                <div class="card-link">View Stock Report <i class="bi bi-arrow-right"></i></div>
            </a>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Active Products</div>
                <div class="card-value" style="color: #059669;">@ViewBag.ActionProducts</div>
                <div class="card-link" style="color: #059669;">Operational Listings</div>
            </div>

            <div class="report-card" style="border-top-color: #dc2626;">
                <div class="card-label">Inactive Products</div>
                <div class="card-value" style="color: #dc2626;">@ViewBag.InactiveProducts</div>
                <div class="card-link" style="color: #dc2626;">Dormant Listings</div>
            </div>

            <a asp-action="StockReport" class="report-card" style="border-top-color: #0891b2;">
                <div class="card-label">Total Stock Units</div>
                <div class="card-value" style="color: #0891b2;">@ViewBag.TotalStock</div>
                <div class="card-link">View Stock <i class="bi bi-arrow-right"></i></div>
            </a>

            <a asp-action="LowStock" class="report-card" style="border-top-color: #ea580c; grid-column: span 1;">
                <div class="card-label">Low Stock Alerts</div>
                <div class="card-value low-stock">@ViewBag.LowStockProducts</div>
                <div class="card-link" style="color: #ea580c;">View Low Stock <i class="bi bi-arrow-right"></i></div>
            </a>
        </div>

        <!-- Category -->
        <div class="section-title">
            <i class="bi bi-grid"></i> Category Report
        </div>

        <div class="report-grid" style="grid-template-columns: repeat(4, 1fr);">
            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Total Categories</div>
                <div class="card-value" style="color: #059669;">@ViewBag.TotalCategories</div>
                <div class="card-link" style="color: #059669;">Catalog Classifications</div>
            </div>
        </div>

        <!-- Customer -->
        <div class="section-title">
            <i class="bi bi-people"></i> Customer Report
        </div>

        <div class="report-grid">
            <a asp-action="CustomerReport" class="report-card" style="border-top-color: #4f46e5;">
                <div class="card-label">Total Customers</div>
                <div class="card-value" style="color: #4f46e5;">@ViewBag.TotalCustomers</div>
                <div class="card-link">View Customer Report <i class="bi bi-arrow-right"></i></div>
            </a>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Active Customers</div>
                <div class="card-value" style="color: #059669;">@ViewBag.ActiveCustomers</div>
                <div class="card-link" style="color: #059669;">Verified Accounts</div>
            </div>
        </div>

        <!-- Supplier -->
        <div class="section-title">
            <i class="bi bi-truck"></i> Supplier Report
        </div>

        <div class="report-grid">
            <a asp-action="SupplierReport" class="report-card" style="border-top-color: #9333ea;">
                <div class="card-label">Total Suppliers</div>
                <div class="card-value" style="color: #9333ea;">@ViewBag.TotalSuppliers</div>
                <div class="card-link">View Supplier Report <i class="bi bi-arrow-right"></i></div>
            </a>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Active Suppliers</div>
                <div class="card-value" style="color: #059669;">@ViewBag.ActiveSuppliers</div>
                <div class="card-link" style="color: #059669;">Vendor Partners</div>
            </div>
        </div>

        <!-- Order -->
        <div class="section-title">
            <i class="bi bi-cart-check"></i> Order Report
        </div>

        <div class="report-grid">
            <a asp-action="SalesReport" class="report-card" style="border-top-color: #d97706;">
                <div class="card-label">Total Orders</div>
                <div class="card-value" style="color: #d97706;">@ViewBag.TotalOrders</div>
                <div class="card-link" style="color: #d97706;">View Sales Report <i class="bi bi-arrow-right"></i></div>
            </a>

            <div class="report-card" style="border-top-color: #d97706;">
                <div class="card-label">Pending Orders</div>
                <div class="card-value" style="color: #d97706;">@ViewBag.PendingOrders</div>
                <div class="card-link" style="color: #d97706;">Awaiting Fulfillment</div>
            </div>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Completed Orders</div>
                <div class="card-value" style="color: #059669;">@ViewBag.CompletedOrders</div>
                <div class="card-link" style="color: #059669;">Fulfilled Invoices</div>
            </div>

            <div class="report-card" style="border-top-color: #dc2626;">
                <div class="card-label">Cancelled Orders</div>
                <div class="card-value" style="color: #dc2626;">@ViewBag.CancelledOrders</div>
                <div class="card-link" style="color: #dc2626;">Terminated Transactions</div>
            </div>
        </div>

        <!-- Sales -->
        <div class="section-title">
            <i class="bi bi-graph-up-arrow"></i> Sales Report & Financials
        </div>

        <div class="report-grid">
            <a asp-action="SalesReport" class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Total Revenue</div>
                <div class="card-value sales-value">₹ @(((decimal)ViewBag.TotalSales).ToString("N2"))</div>
                <div class="card-link" style="color: #059669;">View Sales Report <i class="bi bi-arrow-right"></i></div>
            </a>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">Today's Sales</div>
                <div class="card-value sales-value">₹ @(((decimal)ViewBag.TodaySales).ToString("N2"))</div>
                <div class="card-link" style="color: #059669;">Daily Inflow</div>
            </div>

            <div class="report-card" style="border-top-color: #059669;">
                <div class="card-label">This Month Sales</div>
                <div class="card-value sales-value">₹ @(((decimal)ViewBag.MonthlySales).ToString("N2"))</div>
                <div class="card-link" style="color: #059669;">Monthly Performance</div>
            </div>
        </div>

        <!-- Detailed Reports Navigation Actions -->
        <div class="section-title">
            <i class="bi bi-folder-symlink"></i> Quick Navigation Actions
        </div>

        <div class="report-actions">
            <a asp-action="StockReport" class="action-card">
                Stock Report
                <span class="action-description">Product stock inventory details</span>
            </a>

            <a asp-action="SalesReport" class="action-card">
                Sales Report
                <span class="action-description">Order and financial ledger</span>
            </a>

            <a asp-action="CustomerReport" class="action-card">
                Customer Report
                <span class="action-description">Customer directory analytics</span>
            </a>

            <a asp-action="SupplierReport" class="action-card">
                Supplier Report
                <span class="action-description">Vendor partner records</span>
            </a>

            <a asp-action="LowStock" class="action-card">
                Low Stock Alerts
                <span class="action-description">Items below threshold limit</span>
            </a>
        </div>

    </div>
</div>