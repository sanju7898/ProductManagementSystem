@model IEnumerable<ProductManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Low Stock Report";

    var lowStockCount = Model?.Count() ?? 0;
}

<style>
    .report-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .report-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-logo-box {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #dc2626; /* Red warning accent for Low Stock */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(220, 38, 38, 0.4);
        border: 1px solid #b91c1c;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text a {
            color: #94a3b8;
            text-decoration: none;
        }

            .breadcrumb-text a:hover {
                color: #ffffff;
                text-decoration: underline;
            }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-heading {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .page-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Back to Reports Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 48px;
        padding: 0 24px;
        border-radius: 6px;
        background: #334155;
        border: 1px solid #475569;
        color: #e2e8f0;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: all 0.2s;
    }

        .back-btn:hover {
            background: #475569;
            color: #ffffff;
            text-decoration: none;
        }

    /* WARNING BOX */
    .warning-box {
        margin-bottom: 28px;
        padding: 20px 24px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        display: flex;
        align-items: flex-start;
        gap: 15px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.02);
    }

    .warning-icon {
        color: #dc2626;
        font-size: 22px;
        margin-top: 2px;
    }

    .warning-content strong {
        display: block;
        color: #991b1b;
        font-size: 15px;
        font-family: 'Georgia', serif;
        margin-bottom: 4px;
    }

    .warning-content p {
        margin: 0;
        color: #b91c1c;
        font-size: 13px;
        line-height: 1.5;
        font-weight: 500;
    }

    /* =========================
           TABLE CARD
           ========================= */

    .content-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
        margin-bottom: 28px;
    }

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #f8fafc 0%, #fee2e2 100%);
    }

    .registry-title-area h4 {
        margin: 0 0 4px;
        color: #991b1b;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .registry-title-icon {
        width: 36px;
        height: 36px;
        background: #dc2626;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(220, 38, 38, 0.3);
    }

    .registry-title-area p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .record-count {
        padding: 8px 16px;
        border-radius: 6px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #fecaca;
        box-shadow: 0 2px 4px rgba(220, 38, 38, 0.08);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 950px;
    }

        .report-table thead th {
            background: #334155;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 2px solid #1e293b;
            white-space: nowrap;
        }

        .report-table tbody td {
            padding: 18px 20px;
            font-size: 14px;
            color: #1e293b;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .report-table tbody tr:hover {
            background: #f8fafc;
        }

    .product-id {
        color: #64748b;
        font-weight: bold;
    }

    .product-name {
        color: #0f172a;
        font-weight: bold;
    }

    .price {
        color: #059669;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    /* BADGES */
    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        color: #065f46;
        background: #d1fae5;
        border: 1px solid #a7f3d0;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #ecfdf5;
        color: #059669;
        font-size: 26px;
        border: 1px solid #a7f3d0;
    }

    .empty-state h5 {
        color: #1e293b;
        font-family: 'Georgia', serif;
        margin: 0 0 8px;
        font-size: 18px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    /* =========================
           RAZOR SAFE MEDIA QUERY
           ========================= */

    @@media screen and (max-width: 900px) {
        .report-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-btn {
            width: 100%;
        }

        .warning-box {
            margin: 0 0 20px;
        }
    }
</style>

<div class="report-page">
    <div class="report-container">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="header-left">
                <div class="header-logo-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        <a href="@Url.Action("Index", "Report")">Reports Dashboard</a> <span>/</span> Low Stock Report
                    </div>
                    <div class="title-row">
                        <h1 class="page-heading">Low Stock Report</h1>
                    </div>
                    <p class="page-description">Monitoring active inventory items with stock quantities of 10 or less</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Report")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Reports
            </a>
        </div>

        <!-- WARNING ALERT BOX -->
        <div class="warning-box">
            <div class="warning-icon">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div class="warning-content">
                <strong>Inventory Warning & Restock Alert</strong>
                <p>The following active product items have stock quantities falling at or below the 10-unit threshold. Please consider initiating purchase orders to avoid stockouts.</p>
            </div>
        </div>

        <!-- RECORDS TABLE CARD -->
        <div class="content-card">
            <div class="table-header">
                <div class="registry-title-area">
                    <h4>
                        <span class="registry-title-icon"><i class="bi bi-boxes"></i></span>
                        Low Stock Registry
                    </h4>
                    <p>Official list of products requiring immediate inventory attention</p>
                </div>
                <span class="record-count">
                    <i class="bi bi-database-fill me-1"></i> @lowStockCount @(lowStockCount == 1 ? "Record" : "Records")
                </span>
            </div>

            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Supplier</th>
                                <th>Unit Price</th>
                                <th>Available Stock</th>
                                <th>Catalog Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="product-id">#@product.ProductId</span>
                                    </td>
                                    <td>
                                        <span class="product-name">@product.ProductName</span>
                                    </td>
                                    <td>
                                        @(product.Category?.CategoryName ?? "N/A")
                                    </td>
                                    <td>
                                        @(product.Supplier?.SupplierName ?? "N/A")
                                    </td>
                                    <td>
                                        <span class="price">
                                            ₹ @product.Price.ToString("N2")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="stock-badge">
                                            <i class="bi bi-exclamation-circle-fill"></i> @product.Quantity Units
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status">
                                            <i class="bi bi-check-circle-fill"></i> Active
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <h5>No Low Stock Items Found</h5>
                        <p>Excellent! All active inventory items currently maintain safe stock levels above the threshold.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>