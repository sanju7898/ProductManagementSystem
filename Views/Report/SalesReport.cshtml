@model IEnumerable<ProductManagementSystem.Models.Order>

@{
    ViewData["Title"] = "Sales Report";

    var totalOrders = Model?.Count() ?? 0;
    var totalRevenue = Model?.Sum(x => x.TotalAmount) ?? 0;
}

<style>
    .report-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .report-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-logo-box {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #059669; /* Green financial accent for Sales */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(5, 150, 105, 0.4);
        border: 1px solid #047857;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text a {
            color: #94a3b8;
            text-decoration: none;
        }

            .breadcrumb-text a:hover {
                color: #ffffff;
                text-decoration: underline;
            }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-heading {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .page-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Back to Reports Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 48px;
        padding: 0 24px;
        border-radius: 6px;
        background: #334155;
        border: 1px solid #475569;
        color: #e2e8f0;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: all 0.2s;
    }

        .back-btn:hover {
            background: #475569;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================
           SUMMARY CARDS
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #334155;
        border-radius: 8px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
    }

        .summary-card.summary-orders {
            border-top-color: #2563eb;
        }

        .summary-card.summary-revenue {
            border-top-color: #059669;
        }

    .summary-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 24px;
    }

    .summary-orders .summary-icon {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .summary-revenue .summary-icon {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .summary-content span {
        display: block;
        color: #1e293b;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 0.3px;
    }

    .summary-content small {
        display: block;
        color: #64748b;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .summary-content strong {
        display: block;
        font-size: 28px;
        font-family: 'Georgia', serif;
        margin-top: 2px;
    }

    .summary-orders strong {
        color: #2563eb;
    }

    .summary-revenue strong {
        color: #059669;
    }

    /* =========================
           TABLE CARD
           ========================= */

    .content-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
        margin-bottom: 28px;
    }

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #f8fafc 0%, #ecfdf5 100%);
    }

    .registry-title-area h4 {
        margin: 0 0 4px;
        color: #065f46;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .registry-title-icon {
        width: 36px;
        height: 36px;
        background: #059669;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(5, 150, 105, 0.3);
    }

    .registry-title-area p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .record-count {
        padding: 8px 16px;
        border-radius: 6px;
        background: #ecfdf5;
        color: #065f46;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #a7f3d0;
        box-shadow: 0 2px 4px rgba(5, 150, 105, 0.08);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 1050px;
    }

        .report-table thead th {
            background: #334155;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 2px solid #1e293b;
            white-space: nowrap;
        }

        .report-table tbody td {
            padding: 18px 20px;
            font-size: 14px;
            color: #1e293b;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .report-table tbody tr:hover {
            background: #f8fafc;
        }

    .order-id {
        color: #2563eb;
        font-weight: bold;
    }

    .amount {
        color: #059669;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    /* STATUS BADGES */
    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        border: 1px solid transparent;
    }

    .pending {
        color: #92400e;
        background: #fef3c7;
        border-color: #fde047;
    }

    .completed {
        color: #065f46;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .cancelled {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 26px;
        border: 1px solid #fecaca;
    }

    .empty-state h5 {
        color: #1e293b;
        font-family: 'Georgia', serif;
        margin: 0 0 8px;
        font-size: 18px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    /* =========================
           RAZOR SAFE MEDIA QUERY
           ========================= */

    @@media screen and (max-width: 900px) {
        .report-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .back-btn {
            width: 100%;
        }
    }
</style>

<div class="report-page">
    <div class="report-container">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="header-left">
                <div class="header-logo-box">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        <a href="@Url.Action("Index", "Report")">Reports Dashboard</a> <span>/</span> Sales Financial Report
                    </div>
                    <div class="title-row">
                        <h1 class="page-heading">Sales & Revenue Report</h1>
                    </div>
                    <p class="page-description">Comprehensive financial breakdown of order transactions, line items, and revenue</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Report")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Reports
            </a>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="summary-grid">
            <div class="summary-card summary-orders">
                <div class="summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="summary-content">
                    <small>Processed Invoices</small>
                    <span>Total Sales Transactions</span>
                    <strong>@totalOrders</strong>
                </div>
            </div>

            <div class="summary-card summary-revenue">
                <div class="summary-icon">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <div class="summary-content">
                    <small>Cumulative Earnings</small>
                    <span>Total Revenue Generated</span>
                    <strong>₹ @totalRevenue.ToString("N2")</strong>
                </div>
            </div>
        </div>

        <!-- RECORDS TABLE CARD -->
        <div class="content-card">
            <div class="table-header">
                <div class="registry-title-area">
                    <h4>
                        <span class="registry-title-icon"><i class="bi bi-journal-text"></i></span>
                        Sales Financial Ledger
                    </h4>
                    <p>Official ledger of registered order fulfillments and items</p>
                </div>
                <span class="record-count">
                    <i class="bi bi-database-fill me-1"></i> @totalOrders @(totalOrders == 1 ? "Record" : "Records")
                </span>
            </div>

            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer Name</th>
                                <th>Order Date</th>
                                <th>Product Line Items</th>
                                <th>Total Quantity</th>
                                <th>Total Amount</th>
                                <th>Fulfillment Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="order-id">#@order.OrderId</span>
                                    </td>
                                    <td>
                                        <strong>@(order.Customer?.CustomerName ?? "N/A")</strong>
                                    </td>
                                    <td>
                                        @order.OrderDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (order.orderItems != null && order.orderItems.Any())
                                        {
                                            foreach (var item in order.orderItems)
                                            {
                                                <div style="font-size: 13px; color: #475569;">
                                                    <i class="bi bi-box me-1"></i> @(item.Product?.ProductName ?? "N/A") (x@(item.Quantity))
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="font-weight: bold; color: #2563eb;">
                                            @(order.orderItems?.Sum(x => x.Quantity) ?? 0) Units
                                        </span>
                                    </td>
                                    <td>
                                        <span class="amount">
                                            ₹ @order.TotalAmount.ToString("N2")
                                        </span>
                                    </td>
                                    <td>
                                        @if (order.OrderStatus == "Pending")
                                        {
                                            <span class="status pending">
                                                <i class="bi bi-clock-fill"></i> Pending
                                            </span>
                                        }
                                        else if (order.OrderStatus == "Completed")
                                        {
                                            <span class="status completed">
                                                <i class="bi bi-check-circle-fill"></i> Completed
                                            </span>
                                        }
                                        else if (order.OrderStatus == "Cancelled")
                                        {
                                            <span class="status cancelled">
                                                <i class="bi bi-x-circle-fill"></i> Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status">
                                                @order.OrderStatus
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-receipt"></i>
                        </div>
                        <h5>No Sales Records Found</h5>
                        <p>There are no completed sales transactions logged in the ledger currently.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>