@using ProductManagementSystem.Models

@{
    ViewData["Title"] = "Dashboard";

    bool isSignedIn = User.Identity != null && User.Identity.IsAuthenticated;

    string loggedInUser = isSignedIn
        ? (User.Identity?.Name ?? "User")
        : "";

    string userRole = isSignedIn
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")
        : "";

    string userInitial = !string.IsNullOrWhiteSpace(loggedInUser)
        ? loggedInUser.Substring(0, 1).ToUpper()
        : "U";

    var recentOrders = ViewBag.RecentOrders as IEnumerable<Order>
                        ?? Enumerable.Empty<Order>();

    var lowStockProducts = ViewBag.LowStockProducts as IEnumerable<Product>
                           ?? Enumerable.Empty<Product>();
}

<style>
    /* =====================================================
           GLOBAL DASHBOARD (Classic Enterprise Theme)
           ===================================================== */

    .pms-wrapper {
        display: flex;
        height: 100vh;
        overflow: hidden;
        background-color: #eef2f5;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* =====================================================
           SIDEBAR
           ===================================================== */

    .pms-sidebar {
        width: 270px;
        background-color: #1e293b; /* Classic Dark Slate */
        color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-shrink: 0;
        border-right: 1px solid #0f172a;
    }

    /* BRAND */
    .pms-brand {
        padding: 22px 20px;
        background-color: #0f172a;
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 82px;
        border-bottom: 1px solid #334155;
    }

    .pms-logo-box {
        width: 46px;
        height: 46px;
        background-color: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        flex-shrink: 0;
        border: 1px solid #1d4ed8;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);
    }

    .pms-brand-title {
        font-weight: bold;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
        line-height: 1.4;
        color: #ffffff;
    }

    .pms-brand-sub {
        font-size: 12px;
        color: #38bdf8;
        margin: 2px 0 0 0;
        font-weight: bold;
    }

    /* NAVIGATION */
    .pms-nav {
        margin-top: 18px;
        padding: 0 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-y: auto;
    }

    .pms-nav-link {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 46px;
        padding: 10px 16px;
        color: #94a3b8;
        text-decoration: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: bold;
        transition: all 0.2s ease;
    }

        .pms-nav-link i {
            width: 24px;
            text-align: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .pms-nav-link:hover,
        .pms-nav-link.active {
            background-color: #2563eb;
            color: #ffffff;
            text-decoration: none;
        }

    /* LOGOUT */
    .pms-sidebar-footer {
        padding: 18px 16px;
        border-top: 1px solid #334155;
        background-color: #0f172a;
    }

        .pms-sidebar-footer form {
            width: 100%;
            margin: 0;
        }

    .pms-logout-button {
        width: 100%;
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 14px;
        background-color: #1e293b;
        border: 1px solid #475569;
        color: #cbd5e1;
        border-radius: 6px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        padding: 10px 16px;
        transition: all 0.2s ease;
        text-align: left;
    }

        .pms-logout-button i {
            width: 24px;
            text-align: center;
            font-size: 18px;
        }

        .pms-logout-button span {
            font-size: 14px;
            font-weight: bold;
        }

        .pms-logout-button:hover {
            background-color: #dc2626;
            border-color: #b91c1c;
            color: #ffffff;
            text-decoration: none;
        }

    /* =====================================================
           MAIN CONTENT & HEADER
           ===================================================== */

    .pms-main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        min-width: 0;
    }

    .pms-header {
        min-height: 70px;
        background-color: #ffffff;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        flex-shrink: 0;
    }

    /* SEARCH */
    .pms-search-box {
        position: relative;
        width: 330px;
    }

    .pms-search-input {
        width: 100%;
        padding: 10px 40px 10px 40px;
        background-color: #f8fafc;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        font-size: 14px;
        color: #0f172a;
        outline: none;
        transition: all 0.2s;
    }

        .pms-search-input:focus {
            background-color: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    .pms-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 16px;
        pointer-events: none;
    }

    .pms-search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        display: none;
        padding: 0;
        font-size: 16px;
    }

        .pms-search-clear:hover {
            color: #2563eb;
        }

    .pms-header-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* NOTIFICATION */
    .pms-notif-container {
        position: relative;
    }

    .pms-notif-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #334155;
        font-size: 18px;
        position: relative;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s;
    }

        .pms-notif-btn:hover {
            background-color: #e2e8f0;
            color: #0f172a;
        }

    .pms-notif-dot {
        position: absolute;
        top: -4px;
        right: -4px;
        width: 10px;
        height: 10px;
        background-color: #dc2626;
        border: 2px solid #ffffff;
        border-radius: 50%;
    }

    .pms-notif-dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: 48px;
        width: 330px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        padding: 15px;
        z-index: 1000;
    }

        .pms-notif-dropdown.show {
            display: block;
        }

    .notification-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: bold;
        font-size: 14px;
        color: #1e293b;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
        font-family: 'Georgia', serif;
    }

        .notification-title i {
            color: #2563eb;
            font-size: 16px;
        }

    .notification-item {
        display: flex;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
        color: #475569;
    }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item i {
            color: #d97706;
            font-size: 16px;
            flex-shrink: 0;
        }

    .notification-empty {
        font-size: 13px;
        color: #64748b;
        text-align: center;
        padding: 15px 0;
        font-weight: 500;
    }

        .notification-empty i {
            display: block;
            font-size: 24px;
            color: #059669;
            margin-bottom: 4px;
        }

    /* PROFILE */
    .pms-auth-section {
        display: flex;
        align-items: center;
        border-left: 1px solid #cbd5e1;
        padding-left: 20px;
    }

    .pms-login-btn {
        background-color: #2563eb;
        color: #ffffff;
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #1d4ed8;
        transition: background-color 0.2s;
    }

        .pms-login-btn:hover {
            background-color: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
        }

    .pms-admin-profile {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pms-admin-avatar {
        width: 40px;
        height: 40px;
        background-color: #2563eb;
        color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        flex-shrink: 0;
        border: 1px solid #1d4ed8;
    }

    .pms-admin-name {
        font-size: 14px;
        font-weight: bold;
        color: #1e293b;
        margin: 0;
        line-height: 1.3;
    }

    .pms-admin-role {
        font-size: 12px;
        color: #64748b;
        margin: 2px 0 0 0;
        font-weight: 500;
    }

        .pms-admin-role i {
            font-size: 11px;
            margin-right: 3px;
        }

    /* =====================================================
           DASHBOARD BODY & STATISTICS CARDS
           ===================================================== */

    .dashboard-body {
        padding: 30px;
    }

    .dashboard-title-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .dashboard-main-title {
        font-size: 26px;
        font-weight: bold;
        color: #1e293b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Georgia', serif;
    }

        .dashboard-main-title i {
            color: #2563eb;
            font-size: 26px;
        }

    .dashboard-main-subtitle {
        font-size: 13px;
        color: #64748b;
        margin-top: 4px;
        margin-bottom: 0;
    }

    .dashboard-date-badge {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        padding: 10px 16px;
        border-radius: 6px;
        font-size: 13px;
        color: #334155;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }

    /* STATISTICS GRID */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    .dashboard-card {
        background: #ffffff;
        border-radius: 8px;
        padding: 22px;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #334155;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: inherit;
        min-height: 155px;
    }

        .dashboard-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
            text-decoration: none;
            color: inherit;
        }

    .card-label {
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .card-value {
        color: #0f172a;
        font-size: 28px;
        font-weight: bold;
        font-family: 'Georgia', serif;
    }

    .card-icon {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        border: 1px solid transparent;
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .card-trend {
        font-size: 12px;
        font-weight: bold;
        color: #475467;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        border-top: 1px solid #e2e8f0;
        padding-top: 10px;
    }

        .card-trend i {
            font-size: 14px;
            color: #2563eb;
        }

    /* =====================================================
           OVERVIEW & TABLES
           ===================================================== */

    .overview-section {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 24px;
        margin-bottom: 28px;
    }

    .content-box {
        background: #ffffff;
        border-radius: 8px;
        padding: 24px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.04);
        min-width: 0;
    }

    .box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e2e8f0;
    }

        .box-header h3 {
            font-size: 16px;
            font-weight: bold;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Georgia', serif;
        }

            .box-header h3 i {
                color: #2563eb;
                font-size: 18px;
            }

    .view-all-link {
        font-size: 12px;
        color: #2563eb;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
    }

        .view-all-link:hover {
            text-decoration: underline;
        }

    .sales-placeholder {
        height: 190px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #64748b;
    }

        .sales-placeholder i {
            font-size: 40px;
            color: #2563eb;
            margin-bottom: 8px;
        }

        .sales-placeholder span {
            font-size: 13px;
            font-weight: bold;
        }

    .pms-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 13px;
    }

        .pms-table th {
            background: #334155;
            color: #ffffff;
            font-weight: bold;
            padding: 12px 14px;
            border-bottom: 2px solid #1e293b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .pms-table td {
            padding: 14px;
            border-bottom: 1px solid #e2e8f0;
            color: #1e293b;
            font-weight: 500;
        }

        .pms-table tbody tr:hover {
            background: #f8fafc;
        }

        .pms-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* BADGES */
    .badge-status {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        display: inline-block;
        border: 1px solid transparent;
    }

    .badge-pending {
        background: #fef3c7;
        color: #92400e;
        border-color: #fde047;
    }

    .badge-completed {
        background: #d1fae5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .badge-shipped {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .badge-cancelled {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fecaca;
    }

    .empty-state {
        text-align: center;
        padding: 35px 10px;
        color: #64748b;
        font-size: 13px;
        font-weight: 500;
    }

        .empty-state i {
            display: block;
            font-size: 30px;
            color: #dc2626;
            margin-bottom: 6px;
        }

    /* =====================================================
           RESPONSIVE (Razor Safe: @@media)
           ===================================================== */

    @@media (max-width: 1400px) {
        .dashboard-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 1100px) {
        .pms-sidebar {
            width: 230px;
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .overview-section {
            grid-template-columns: 1fr;
        }

        .pms-search-box {
            width: 260px;
        }
    }

    @@media (max-width: 850px) {
        .pms-sidebar {
            display: none;
        }

        .pms-header {
            padding: 0 18px;
        }

        .dashboard-body {
            padding: 20px;
        }
    }

    @@media (max-width: 600px) {
        .pms-header {
            min-height: 65px;
            padding: 0 12px;
        }

        .pms-search-box {
            width: 180px;
        }

        .dashboard-body {
            padding: 15px;
        }

        .dashboard-title-area {
            align-items: flex-start;
            gap: 12px;
            flex-direction: column;
        }

        .dashboard-date-badge {
            width: 100%;
            justify-content: center;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="pms-wrapper">

    <!-- SIDEBAR -->
    <aside class="pms-sidebar">
        <div>
            <!-- BRAND -->
            <div class="pms-brand">
                <div class="pms-logo-box">
                    PMS
                </div>
                <div>
                    <h1 class="pms-brand-title">Product Management</h1>
                    <p class="pms-brand-sub">Enterprise Portal</p>
                </div>
            </div>

            <!-- MENU -->
            <nav class="pms-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="pms-nav-link active">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Product" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-box-seam"></i>
                    <span>Products</span>
                </a>

                <a asp-controller="Category" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-grid"></i>
                    <span>Categories</span>
                </a>

                <a asp-controller="Customer" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>

                <a asp-controller="Supplier" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-truck"></i>
                    <span>Suppliers</span>
                </a>

                <a asp-controller="Order" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-cart-check"></i>
                    <span>Orders</span>
                </a>

                <a asp-controller="Report" asp-action="Index" class="pms-nav-link">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>
            </nav>
        </div>

        <!-- LOGOUT -->
        <div class="pms-sidebar-footer">
            @if (isSignedIn)
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pms-logout-button">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout System</span>
                    </button>
                </form>
            }
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="pms-main-content">

        <!-- HEADER -->
        <header class="pms-header">
            <!-- SEARCH -->
            <div class="pms-search-box">
                <i class="bi bi-search pms-search-icon"></i>
                <input type="text"
                       id="globalSearchInput"
                       class="pms-search-input"
                       placeholder="Filter records..."
                       autocomplete="off" />
                <button type="button"
                        id="clearSearchBtn"
                        class="pms-search-clear"
                        onclick="clearDashboardSearch()">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>

            <!-- HEADER RIGHT -->
            <div class="pms-header-right">
                <!-- NOTIFICATION -->
                <div class="pms-notif-container">
                    <button type="button"
                            class="pms-notif-btn"
                            id="notifBtn"
                            onclick="toggleNotifications()"
                            title="System Notifications">
                        <i class="bi bi-bell-fill"></i>
                        @if (lowStockProducts.Any())
                        {
                            <span class="pms-notif-dot"></span>
                        }
                    </button>

                    <div class="pms-notif-dropdown" id="notifDropdown">
                        <div class="notification-title">
                            <i class="bi bi-bell-fill"></i>
                            <span>System Alerts</span>
                        </div>

                        @if (lowStockProducts.Any())
                        {
                            foreach (var product in lowStockProducts.Take(5))
                            {
                                <div class="notification-item">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>
                                        <strong>@product.ProductName</strong> requires stock replenishment (Qty: @product.Quantity).
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="notification-empty">
                                <i class="bi bi-check-circle-fill"></i>
                                All inventory levels are stable.
                            </div>
                        }
                    </div>
                </div>

                <!-- PROFILE -->
                <div class="pms-auth-section">
                    @if (!isSignedIn)
                    {
                        <a asp-controller="Account" asp-action="Login" class="pms-login-btn">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                    }
                    else
                    {
                        <div class="pms-admin-profile">
                            <div class="pms-admin-avatar">
                                @userInitial
                            </div>
                            <div>
                                <p class="pms-admin-name">@loggedInUser</p>
                                <p class="pms-admin-role">
                                    <i class="bi bi-shield-check"></i> @userRole
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- DASHBOARD BODY -->
        <main class="dashboard-body">

            <!-- TITLE -->
            <div class="dashboard-title-area">
                <div>
                    <h2 class="dashboard-main-title">
                        <i class="bi bi-speedometer2"></i> Administrative Dashboard
                    </h2>
                    <p class="dashboard-main-subtitle">
                        Welcome back, @loggedInUser! Verified system metrics and live business overview.
                    </p>
                </div>

                <!-- DATE -->
                <div class="dashboard-date-badge">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <span id="currentLiveDate">Loading date...</span>
                </div>
            </div>

            <!-- STATISTICS CARDS -->
            <div class="dashboard-grid">

                <!-- PRODUCT -->
                <a asp-controller="Product" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #2563eb;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Total Products</div>
                            <div class="card-value" style="color: #2563eb;">@ViewBag.TotalProducts</div>
                        </div>
                        <div class="card-icon" style="background:#eff6ff;color:#2563eb;border-color:#bfdbfe;">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Manage Inventory
                    </div>
                </a>

                <!-- CATEGORY -->
                <a asp-controller="Category" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #059669;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Categories</div>
                            <div class="card-value" style="color: #059669;">@ViewBag.TotalCategorie</div>
                        </div>
                        <div class="card-icon" style="background:#ecfdf5;color:#059669;border-color:#a7f3d0;">
                            <i class="bi bi-grid-fill"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Manage Categories
                    </div>
                </a>

                <!-- CUSTOMER -->
                <a asp-controller="Customer" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #4f46e5;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Customers</div>
                            <div class="card-value" style="color: #4f46e5;">@ViewBag.TotalCustomer</div>
                        </div>
                        <div class="card-icon" style="background:#eef2ff;color:#4f46e5;border-color:#c7d2fe;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Verified Directory
                    </div>
                </a>

                <!-- SUPPLIER -->
                <a asp-controller="Supplier" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #9333ea;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Suppliers</div>
                            <div class="card-value" style="color: #9333ea;">@ViewBag.TotalSuppliers</div>
                        </div>
                        <div class="card-icon" style="background:#f3e8ff;color:#9333ea;border-color:#e9d5ff;">
                            <i class="bi bi-truck"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Vendor Registry
                    </div>
                </a>

                <!-- ORDER -->
                <a asp-controller="Order" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #d97706;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Orders</div>
                            <div class="card-value" style="color: #d97706;">@ViewBag.TotalOrder</div>
                        </div>
                        <div class="card-icon" style="background:#fef3c7;color:#d97706;border-color:#fde047;">
                            <i class="bi bi-cart-check-fill"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Sales Pipeline
                    </div>
                </a>

                <!-- STOCK -->
                <a asp-controller="Product" asp-action="Index" class="dashboard-card searchable-card" style="border-top-color: #0891b2;">
                    <div class="card-top">
                        <div>
                            <div class="card-label">Total Stock</div>
                            <div class="card-value" style="color: #0891b2;">@ViewBag.TotalStock</div>
                        </div>
                        <div class="card-icon" style="background:#ecfeff;color:#0891b2;border-color:#a5f3fc;">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                    <div class="card-trend">
                        <i class="bi bi-arrow-right-short"></i> Stock Units
                    </div>
                </a>

            </div>

            <!-- SALES + LOW STOCK OVERVIEW -->
            <div class="overview-section">

                <!-- SALES -->
                <div class="content-box">
                    <div class="box-header">
                        <h3>
                            <i class="bi bi-graph-up"></i> Sales Overview
                        </h3>
                        <a asp-controller="Report" asp-action="SalesReport" class="view-all-link">
                            View Report
                        </a>
                    </div>

                    <div class="sales-placeholder">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        <span>Sales analytics available in Reports module</span>
                    </div>
                </div>

                <!-- LOW STOCK -->
                <div class="content-box">
                    <div class="box-header">
                        <h3>
                            <i class="bi bi-exclamation-triangle text-danger"></i> Low Stock Alerts
                        </h3>
                        <a asp-controller="Report" asp-action="LowStock" class="view-all-link">
                            View All
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="pms-table" id="lowStockTable">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th style="text-align:right;">Stock Units</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lowStockProducts.Any())
                                {
                                    foreach (var product in lowStockProducts.Take(5))
                                    {
                                        <tr class="searchable-row">
                                            <td>
                                                <i class="bi bi-box-seam me-2 text-secondary"></i> @product.ProductName
                                            </td>
                                            <td>
                                                @(product.Category?.CategoryName ?? "N/A")
                                            </td>
                                            <td style="text-align:right;">
                                                <span class="badge-status" style="background:#fee2e2;color:#991b1b;border-color:#fecaca;">
                                                    @product.Quantity Units
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3">
                                            <div class="empty-state">
                                                <i class="bi bi-check-circle-fill" style="color:#059669;"></i>
                                                All inventory items have sufficient stock levels.
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- RECENT ORDERS -->
            <div class="content-box">
                <div class="box-header">
                    <h3>
                        <i class="bi bi-cart-check"></i> Recent Orders Directory
                    </h3>
                    <a asp-controller="Order" asp-action="Index" class="view-all-link">
                        View All Orders
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="pms-table" id="recentOrdersTable">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer Name</th>
                                <th>Order Date</th>
                                <th>Status</th>
                                <th style="text-align:right;">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders.Any())
                            {
                                foreach (var order in recentOrders.Take(5))
                                {
                                    <tr class="searchable-row">
                                        <td style="font-weight:bold;color:#2563eb;">
                                            #@order.OrderId
                                        </td>
                                        <td>
                                            @(order.Customer?.CustomerName ?? "N/A")
                                        </td>
                                        <td>
                                            @order.OrderDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            @if (order.OrderStatus == "Pending")
                                            {
                                                <span class="badge-status badge-pending">Pending</span>
                                            }
                                            else if (order.OrderStatus == "Completed")
                                            {
                                                <span class="badge-status badge-completed">Completed</span>
                                            }
                                            else if (order.OrderStatus == "Shipped")
                                            {
                                                <span class="badge-status badge-shipped">Shipped</span>
                                            }
                                            else if (order.OrderStatus == "Cancelled")
                                            {
                                                <span class="badge-status badge-cancelled">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status">@order.OrderStatus</span>
                                            }
                                        </td>
                                        <td style="text-align:right;font-weight:bold;color:#059669;">
                                            ₹ @order.TotalAmount.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">
                                            <i class="bi bi-cart-x"></i>
                                            No recent order records found in the registry.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    function updateCurrentDate() {
        const dateElement = document.getElementById("currentLiveDate");
        if (!dateElement) return;
        const today = new Date();
        const options = { weekday: "long", day: "2-digit", month: "long", year: "numeric" };
        dateElement.innerText = today.toLocaleDateString("en-IN", options);
    }

    function toggleNotifications() {
        const dropdown = document.getElementById("notifDropdown");
        if (!dropdown) return;
        dropdown.classList.toggle("show");
    }

    document.addEventListener("click", function (event) {
        const notificationContainer = document.querySelector(".pms-notif-container");
        const dropdown = document.getElementById("notifDropdown");
        if (!notificationContainer || !dropdown) return;
        if (!notificationContainer.contains(event.target)) {
            dropdown.classList.remove("show");
        }
    });

    function filterDashboard() {
        const input = document.getElementById("globalSearchInput");
        const clearButton = document.getElementById("clearSearchBtn");
        if (!input) return;
        const searchText = input.value.toLowerCase().trim();

        if (clearButton) {
            clearButton.style.display = searchText.length > 0 ? "block" : "none";
        }

        const cards = document.querySelectorAll(".searchable-card");
        cards.forEach(function (card) {
            const cardText = card.textContent.toLowerCase();
            card.style.display = cardText.includes(searchText) ? "" : "none";
        });

        const rows = document.querySelectorAll(".searchable-row");
        rows.forEach(function (row) {
            const rowText = row.textContent.toLowerCase();
            row.style.display = rowText.includes(searchText) ? "" : "none";
        });
    }

    function clearDashboardSearch() {
        const input = document.getElementById("globalSearchInput");
        if (!input) return;
        input.value = "";
        filterDashboard();
        input.focus();
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateCurrentDate();
        const searchInput = document.getElementById("globalSearchInput");
        if (searchInput) {
            searchInput.addEventListener("input", filterDashboard);
        }
    });
</script>