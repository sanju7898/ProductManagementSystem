@model ProductManagementSystem.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<style>
    .order-delete-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .order-delete-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .delete-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .delete-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .delete-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #dc2626; /* Red for Delete match */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(220, 38, 38, 0.4);
        border: 1px solid #b91c1c;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .delete-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .delete-subtitle {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           CARD WITH RED TOP ACCENT
           ========================= */

    .delete-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #dc2626;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* WARNING BOX */
    .warning-box {
        margin: 28px 28px 0;
        padding: 20px 24px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .warning-icon {
        color: #dc2626;
        font-size: 22px;
        margin-top: 2px;
    }

    .warning-content strong {
        display: block;
        color: #991b1b;
        font-size: 15px;
        font-family: 'Georgia', serif;
        margin-bottom: 4px;
    }

    .warning-content p {
        margin: 0;
        color: #b91c1c;
        font-size: 13px;
        line-height: 1.5;
        font-weight: 500;
    }

    .details-body {
        padding: 28px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .info-item {
        padding: 18px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .info-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .info-label i {
            color: #dc2626;
            font-size: 14px;
        }

    .info-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: bold;
        word-break: break-word;
    }

    /* ORDER ITEMS TABLE */
    .items-title {
        font-size: 16px;
        font-weight: bold;
        color: #1e3a8a;
        margin-bottom: 14px;
        font-family: 'Georgia', serif;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .item-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .item-table th {
            background: #334155;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 14px 18px;
            border-bottom: 2px solid #1e293b;
            text-align: left;
        }

        .item-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
            color: #1e293b;
            font-weight: 500;
        }

        .item-table tr:hover {
            background: #f8fafc;
        }

    .total-box {
        text-align: right;
        margin-top: 15px;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
        color: #dc2626;
    }

    /* ACTION BUTTONS */
    .button-area {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-cancel {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .btn-delete {
        background: #dc2626;
        color: #ffffff;
        border-color: #b91c1c;
        box-shadow: 0 3px 8px rgba(220, 38, 38, 0.25);
    }

        .btn-delete:hover {
            background: #b91c1c;
            border-color: #991b1b;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 750px) {
        .order-delete-page {
            padding: 15px;
        }

        .delete-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .button-area {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .warning-box {
            margin: 15px 15px 0;
        }

        .details-body {
            padding: 20px;
        }

        .item-table {
            min-width: 650px;
        }
    }
</style>

<div class="order-delete-page">
    <div class="order-delete-container">

        <!-- Header -->
        <div class="delete-header">
            <div class="delete-header-left">
                <div class="delete-header-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Order Management <span>/</span> Delete
                    </div>
                    <h1 class="delete-title">Delete Order</h1>
                    <p class="delete-subtitle">Review order particulars securely before permanent deletion.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Order")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>

        <!-- Delete Card -->
        <div class="delete-card">

            <!-- Warning Box -->
            <div class="warning-box">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="warning-content">
                    <strong>Are you sure you want to permanently delete this sales order?</strong>
                    <p>Deleting this record will remove associated order items and restore product quantities back to stock inventory.</p>
                </div>
            </div>

            <div class="details-body">

                <!-- Order Information Grid -->
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-hash"></i> Order ID</span>
                        <span class="info-value">#@Model.OrderId</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-person-fill"></i> Customer</span>
                        <span class="info-value">@(Model.Customer?.CustomerName ?? "N/A")</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-calendar3"></i> Order Date</span>
                        <span class="info-value">@Model.OrderDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-toggle-on"></i> Status</span>
                        <span class="info-value">@Model.OrderStatus</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-currency-rupee"></i> Total Amount</span>
                        <span class="info-value" style="color:#059669; font-family:'Georgia', serif;">₹ @Model.TotalAmount.ToString("N2")</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label"><i class="bi bi-card-text"></i> Notes</span>
                        <span class="info-value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</span>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="items-title">
                    <i class="bi bi-box-seam me-1"></i> Associated Order Items
                </div>

                <div class="table-responsive">
                    <table class="item-table">
                        <thead>
                            <tr>
                                <th>Product Item</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th style="text-align:right;">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.orderItems != null && Model.orderItems.Any())
                            {
                                foreach (var item in Model.orderItems)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-box me-2 text-secondary"></i>
                                            @(item.Product?.ProductName ?? "N/A")
                                        </td>
                                        <td>@item.Quantity</td>
                                        <td>₹ @item.UnitPrice.ToString("N2")</td>
                                        <td style="text-align:right; font-weight:bold; color:#059669;">
                                            ₹ @(item.TotalPrice?.ToString("N2") ?? "0.00")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; color:#64748b; padding: 20px;">
                                        No order items found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Total Box -->
                <div class="total-box">
                    Total Invoice Amount: ₹ @Model.TotalAmount.ToString("N2")
                </div>

                <!-- Delete Form -->
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />

                    <div class="button-area">
                        <a href="@Url.Action("Index", "Order")" class="btn-custom btn-cancel">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn-custom btn-delete" onclick="return confirm('Are you sure you want to permanently delete this order?');">
                            <i class="bi bi-trash3-fill"></i> Delete Order
                        </button>
                    </div>
                </form>

            </div>

        </div>

    </div>
</div>