@model ProductManagementSystem.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<style>
    .order-edit-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .order-edit-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .edit-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .edit-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #d97706; /* Amber for Edit match */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.4);
        border: 1px solid #b45309;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .edit-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .edit-subtitle {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           FORM CARD WITH AMBER TOP ACCENT
           ========================= */

    .edit-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #d97706;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #fef3c7 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-left-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #d97706;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(217, 119, 6, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #78350f;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .required-label {
        font-size: 12px;
        color: #dc2626;
        font-weight: bold;
    }

    .form-body {
        padding: 32px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group-custom {
        margin-bottom: 20px;
    }

        .form-group-custom.full-width {
            grid-column: 1 / -1;
        }

    .form-label-custom {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .required-star {
        color: #dc2626;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #d97706;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.1);
        }

    textarea.form-control-custom {
        height: auto;
        padding: 14px 16px;
        resize: vertical;
    }

    select.form-control-custom {
        cursor: pointer;
    }

    /* VALIDATION & ERROR */
    .validation-message {
        color: #dc2626;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    /* BUTTONS */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        margin-top: 10px;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .cancel-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .update-btn {
        background: #d97706;
        color: #ffffff;
        border-color: #b45309;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.25);
    }

        .update-btn:hover {
            background: #b45309;
            border-color: #92400e;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .order-edit-page {
            padding: 15px;
        }

        .edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="order-edit-page">
    <div class="order-edit-container">

        <!-- Header -->
        <div class="edit-header">
            <div class="edit-header-left">
                <div class="edit-header-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Order Management <span>/</span> Edit
                    </div>
                    <h1 class="edit-title">Edit Order</h1>
                    <p class="edit-subtitle">Update customer, status, and associated order notes.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Order")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>

        <!-- Form Card -->
        <div class="edit-card">
            <div class="card-header-custom">
                <div class="card-header-left-group">
                    <div class="card-header-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="card-header-text">
                        <h4>Order Particulars (#@Model.OrderId)</h4>
                        <p>Modify order configuration and tracking status below.</p>
                    </div>
                </div>
                <span class="required-label">* Required Fields</span>
            </div>

            <div class="form-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.OrderId" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

                    <div class="form-grid">

                        <!-- Customer -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Customer Name <span class="required-star">*</span>
                            </label>
                            <select name="CustomerId" class="form-control-custom">
                                @if (ViewBag.Customers != null)
                                {
                                    @foreach (var customer in ViewBag.Customers)
                                    {
                                        if (customer.CustomerId == Model.CustomerId)
                                        {
                                            <option value="@customer.CustomerId" selected>@customer.CustomerName</option>
                                        }
                                        else
                                        {
                                            <option value="@customer.CustomerId">@customer.CustomerName</option>
                                        }
                                    }
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="validation-message"></span>
                        </div>

                        <!-- Order Status -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Order Status <span class="required-star">*</span>
                            </label>
                            <select name="OrderStatus" class="form-control-custom">
                                <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending</option>
                                <option value="Completed" selected="@(Model.OrderStatus == "Completed")">Completed</option>
                                <option value="Shipped" selected="@(Model.OrderStatus == "Shipped")">Shipped</option>
                                <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                            </select>
                        </div>

                        <!-- Order Date -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Order Date
                            </label>
                            <input type="text"
                                   class="form-control-custom bg-light"
                                   value="@Model.OrderDate.ToString("dd MMM yyyy hh:mm tt")"
                                   readonly />
                        </div>

                        <!-- Total Amount -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Total Amount (₹)
                            </label>
                            <input type="text"
                                   class="form-control-custom bg-light"
                                   value="₹ @Model.TotalAmount.ToString("N2")"
                                   readonly />
                        </div>

                        <!-- Notes -->
                        <div class="form-group-custom full-width">
                            <label class="form-label-custom">
                                Order Notes
                            </label>
                            <textarea name="Notes"
                                      class="form-control-custom"
                                      rows="4"
                                      placeholder="Enter remarks or tracking details...">@Model.Notes</textarea>
                        </div>

                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Order")" class="btn-custom cancel-btn">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn-custom update-btn">
                            <i class="bi bi-check-circle-fill"></i> Update Order
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}