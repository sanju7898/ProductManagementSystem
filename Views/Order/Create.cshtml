@model ProductManagementSystem.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<style>
    .order-create-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .order-create-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .create-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .create-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .create-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb;
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
        border: 1px solid #1d4ed8;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .create-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .create-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           FORM CARD WITH TOP ACCENT
           ========================= */

    .create-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #2563eb;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-left-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #1e3a8a;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .required-label {
        font-size: 12px;
        color: #dc2626;
        font-weight: bold;
    }

    .form-body {
        padding: 32px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group-custom {
        margin-bottom: 20px;
    }

        .form-group-custom.full-width {
            grid-column: 1 / -1;
        }

    .form-label-custom {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .required-star {
        color: #dc2626;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    textarea.form-control-custom {
        height: auto;
        padding: 14px 16px;
        resize: vertical;
    }

    select.form-control-custom {
        cursor: pointer;
    }

    .stock-info {
        font-size: 12px;
        color: #64748b;
        margin-top: 6px;
        font-weight: 500;
    }

    /* VALIDATION & ERROR */
    .validation-message {
        color: #dc2626;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    /* BUTTONS */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        margin-top: 10px;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .cancel-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .save-btn {
        background: #2563eb;
        color: #ffffff;
        border-color: #1d4ed8;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.25);
    }

        .save-btn:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .order-create-page {
            padding: 15px;
        }

        .create-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="order-create-page">
    <div class="order-create-container">

        <!-- Header -->
        <div class="create-header">
            <div class="create-header-left">
                <div class="create-header-icon">
                    <i class="bi bi-cart-plus-fill"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Order Management <span>/</span> Create
                    </div>
                    <h1 class="create-title">Create Order</h1>
                    <p class="create-description">Process and record a new customer sales order securely.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Order")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>

        <!-- Form Card -->
        <div class="create-card">
            <div class="card-header-custom">
                <div class="card-header-left-group">
                    <div class="card-header-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="card-header-text">
                        <h4>Order Particulars</h4>
                        <p>Select customer, product catalog item, and quantity parameters.</p>
                    </div>
                </div>
                <span class="required-label">* Required Fields</span>
            </div>

            <div class="form-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

                    <div class="form-grid">

                        <!-- Customer -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Customer Name <span class="required-star">*</span>
                            </label>
                            <select name="CustomerId" class="form-control-custom">
                                <option value="0">-- Select Customer --</option>
                                @if (ViewBag.Customers != null)
                                {
                                    @foreach (var customer in ViewBag.Customers)
                                    {
                                        <option value="@customer.CustomerId">@customer.CustomerName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Product -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Product Item <span class="required-star">*</span>
                            </label>
                            <select name="ProductId" class="form-control-custom">
                                <option value="0">-- Select Product --</option>
                                @if (ViewBag.Products != null)
                                {
                                    @foreach (var product in ViewBag.Products)
                                    {
                                        <option value="@product.ProductId">
                                            @product.ProductName - ₹@product.Price (Stock: @product.Quantity)
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Quantity -->
                        <div class="form-group-custom">
                            <label class="form-label-custom">
                                Order Quantity <span class="required-star">*</span>
                            </label>
                            <input type="number"
                                   name="Quantity"
                                   class="form-control-custom"
                                   min="1"
                                   placeholder="Enter quantity" />
                            <div class="stock-info">
                                <i class="bi bi-info-circle me-1"></i> Available stock is verified automatically upon submission.
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="form-group-custom full-width">
                            <label class="form-label-custom">
                                Order Notes
                            </label>
                            <textarea name="Notes"
                                      class="form-control-custom"
                                      rows="4"
                                      placeholder="Enter optional dispatch remarks or delivery instructions..."></textarea>
                        </div>

                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Order")" class="btn-custom cancel-btn">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn-custom save-btn">
                            <i class="bi bi-plus-circle-fill"></i> Create Order
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}