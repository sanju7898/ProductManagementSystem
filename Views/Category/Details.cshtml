@model ProductManagementSystem.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<style>
    .category-details-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .category-details-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .details-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .details-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb; /* Blue for Details */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
        border: 1px solid #1d4ed8;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .details-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .details-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           DETAILS CARD WITH TOP ACCENT
           ========================= */

    .details-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #2563eb;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #1e3a8a;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .details-body {
        padding: 32px 28px;
    }

    .category-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        margin-bottom: 24px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .category-avatar {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        font-size: 24px;
        border: 1px solid #bfdbfe;
    }

    .category-profile-info h3 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .category-profile-info p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        font-weight: bold;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .detail-item {
        padding: 18px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

        .detail-item.full-width {
            grid-column: 1 / -1;
        }

    .detail-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .detail-label i {
            color: #2563eb;
            font-size: 14px;
        }

    .detail-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: bold;
        word-break: break-word;
    }

    .description-value {
        color: #475569;
        font-size: 14px;
        line-height: 1.6;
        font-weight: normal;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        border: 1px solid transparent;
    }

    .status-active {
        color: #065f46;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .status-inactive {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    /* AUTOMATIC ICON INFO BOX */
    .icon-info {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 22px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .icon-info-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 16px;
        border: 1px solid #bfdbfe;
    }

    .icon-info-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .icon-info-text strong {
            color: #1e293b;
            font-size: 13px;
            font-weight: bold;
        }

        .icon-info-text span {
            color: #64748b;
            font-size: 12px;
        }

    /* ACTION BUTTONS */
    .details-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-back {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .btn-back:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .btn-edit {
        background: #d97706; /* Amber for Edit match */
        color: #ffffff;
        border-color: #b45309;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.25);
    }

        .btn-edit:hover {
            background: #b45309;
            color: #ffffff;
            text-decoration: none;
        }

    .btn-delete {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fca5a5;
    }

        .btn-delete:hover {
            background: #fecaca;
            color: #7f1d1d;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .category-details-page {
            padding: 15px;
        }

        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .details-actions {
            flex-direction: column;
        }

        .btn-custom {
            width: 100%;
        }

        .category-profile {
            align-items: flex-start;
        }
    }
</style>

<div class="category-details-page">
    <div class="category-details-container">

        <!-- Header -->
        <div class="details-header">
            <div class="details-header-left">
                <div class="details-header-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Category Management <span>/</span> Details
                    </div>
                    <h1 class="details-title">Category Details</h1>
                    <p class="details-description">View complete verified profile information for this category.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Category")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
        </div>

        <!-- Details Card -->
        <div class="details-card">
            <div class="card-header-custom">
                <div class="card-header-icon">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div class="card-header-text">
                    <h4>Registry Overview</h4>
                    <p>Detailed breakdown of category particulars and account status.</p>
                </div>
            </div>

            <div class="details-body">

                <!-- Category Profile -->
                <div class="category-profile">
                    <div class="category-avatar">
                        <i id="categoryDetailsIcon" class="bi bi-folder-fill"></i>
                    </div>
                    <div class="category-profile-info">
                        <h3>@Model.CategoryName</h3>
                        <p>Category ID: #@Model.CategoryId</p>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="details-grid">

                    <!-- Category Name -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-tag-fill"></i> Category Name
                        </div>
                        <div class="detail-value">
                            @Model.CategoryName
                        </div>
                    </div>

                    <!-- Category ID -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-hash"></i> Category ID
                        </div>
                        <div class="detail-value">
                            #@Model.CategoryId
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="detail-item full-width">
                        <div class="detail-label">
                            <i class="bi bi-card-text"></i> Description
                        </div>
                        <div class="detail-value description-value">
                            @if (string.IsNullOrWhiteSpace(Model.CategoryDescription))
                            {
                                <span class="text-muted">No description provided.</span>
                            }
                            else
                            {
                                @Model.CategoryDescription
                            }
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-toggle-on"></i> Account Status
                        </div>
                        <div class="detail-value">
                            @if (Model.IsAction)
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-check-circle-fill"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="bi bi-x-circle-fill"></i> Inactive
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Created Date -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-calendar3"></i> Registration Date
                        </div>
                        <div class="detail-value">
                            @Model.CreatedDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                </div>

                <!-- Automatic Icon Info Box -->
                <div class="icon-info">
                    <div class="icon-info-icon">
                        <i id="iconInfoPreview" class="bi bi-folder-fill"></i>
                    </div>
                    <div class="icon-info-text">
                        <strong>Automatic Category Icon</strong>
                        <span id="iconInfoText">Icon selected dynamically according to category name.</span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="details-actions">
                    <a href="@Url.Action("Index", "Category")" class="btn-custom btn-back">
                        <i class="bi bi-list"></i> Return to Directory
                    </a>

                    <div style="display: flex; gap: 10px;">
                        <a href="@Url.Action("Edit", "Category", new { id = Model.CategoryId })" class="btn-custom btn-edit">
                            <i class="bi bi-pencil-square"></i> Edit Category
                        </a>
                        <a href="@Url.Action("Delete", "Category", new { id = Model.CategoryId })" class="btn-custom btn-delete">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryName = "@Html.Raw(Model.CategoryName ?? "")".toLowerCase().trim();
            const detailsIcon = document.getElementById("categoryDetailsIcon");
            const infoIcon = document.getElementById("iconInfoPreview");
            const infoText = document.getElementById("iconInfoText");

            let icon = "bi-folder-fill";
            let text = "General category classification";

            if (categoryName.includes("mobile") || categoryName.includes("phone") || categoryName.includes("smartphone") || categoryName.includes("iphone")) {
                icon = "bi-phone-fill";
                text = "Mobile / Smartphone category";
            } else if (categoryName.includes("laptop") || categoryName.includes("computer") || categoryName.includes("pc")) {
                icon = "bi-laptop-fill";
                text = "Laptop / Computer category";
            } else if (categoryName.includes("electronic") || categoryName.includes("electronics") || categoryName.includes("tv") || categoryName.includes("television")) {
                icon = "bi-tv-fill";
                text = "Electronics category";
            } else if (categoryName.includes("cloth") || categoryName.includes("fashion") || categoryName.includes("dress") || categoryName.includes("garment")) {
                icon = "bi-person-standing-dress";
                text = "Clothing & Fashion category";
            } else if (categoryName.includes("shoe") || categoryName.includes("footwear") || categoryName.includes("sandal")) {
                icon = "bi-person-walking";
                text = "Footwear & Shoes category";
            } else if (categoryName.includes("grocery") || categoryName.includes("supermarket") || categoryName.includes("shopping")) {
                icon = "bi-cart-fill";
                text = "Grocery & Shopping category";
            } else if (categoryName.includes("food") || categoryName.includes("restaurant") || categoryName.includes("hotel") || categoryName.includes("bakery")) {
                icon = "bi-cup-hot-fill";
                text = "Food & Restaurant category";
            } else if (categoryName.includes("book") || categoryName.includes("education") || categoryName.includes("school") || categoryName.includes("college")) {
                icon = "bi-book-fill";
                text = "Books & Education category";
            } else if (categoryName.includes("software") || categoryName.includes("programming") || categoryName.includes("developer") || categoryName.includes("it ")) {
                icon = "bi-code-slash";
                text = "Software & IT category";
            } else if (categoryName.includes("car") || categoryName.includes("auto") || categoryName.includes("automobile") || categoryName.includes("vehicle") || categoryName.includes("bike")) {
                icon = "bi-car-front-fill";
                text = "Automobile & Vehicle category";
            } else if (categoryName.includes("company") || categoryName.includes("business") || categoryName.includes("corporate") || categoryName.includes("office")) {
                icon = "bi-building-fill";
                text = "Corporate & Business category";
            } else if (categoryName.includes("furniture") || categoryName.includes("home") || categoryName.includes("house")) {
                icon = "bi-house-fill";
                text = "Furniture & Home category";
            } else if (categoryName.includes("beauty") || categoryName.includes("cosmetic") || categoryName.includes("salon")) {
                icon = "bi-stars";
                text = "Beauty & Cosmetics category";
            } else if (categoryName.includes("medicine") || categoryName.includes("medical") || categoryName.includes("pharmacy") || categoryName.includes("health")) {
                icon = "bi-heart-pulse-fill";
                text = "Medical & Healthcare category";
            } else if (categoryName.includes("sport") || categoryName.includes("fitness") || categoryName.includes("gym")) {
                icon = "bi-trophy-fill";
                text = "Sports & Fitness category";
            } else if (categoryName.includes("tool") || categoryName.includes("hardware")) {
                icon = "bi-tools";
                text = "Tools & Hardware category";
            } else if (categoryName.includes("camera") || categoryName.includes("photography")) {
                icon = "bi-camera-fill";
                text = "Camera & Photography category";
            } else if (categoryName.includes("music") || categoryName.includes("audio") || categoryName.includes("song")) {
                icon = "bi-music-note-beamed";
                text = "Music & Audio category";
            }

            if (detailsIcon) detailsIcon.className = "bi " + icon;
            if (infoIcon) infoIcon.className = "bi " + icon;
            if (infoText) infoText.textContent = text;
        });
    </script>
}