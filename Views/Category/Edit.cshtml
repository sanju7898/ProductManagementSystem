@model ProductManagementSystem.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<style>
    .category-edit-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .category-edit-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .edit-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .edit-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #d97706; /* Amber for Edit match */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.4);
        border: 1px solid #b45309;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .edit-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .edit-subtitle {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           FORM CARD WITH AMBER TOP ACCENT
           ========================= */

    .edit-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #d97706;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #fef3c7 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-left-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #d97706;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(217, 119, 6, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #78350f;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .required-label {
        font-size: 12px;
        color: #dc2626;
        font-weight: bold;
    }

    .form-body {
        padding: 32px 28px;
    }

    .form-group-custom {
        margin-bottom: 24px;
    }

    .form-label-custom {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .required-star {
        color: #dc2626;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #d97706;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.1);
        }

    textarea.form-control-custom {
        height: auto;
        padding: 14px 16px;
        resize: vertical;
    }

    /* AUTOMATIC ICON PREVIEW BOX */
    .icon-preview-box {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 12px;
        padding: 14px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .icon-preview {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #fef3c7;
        color: #d97706;
        font-size: 18px;
        border: 1px solid #fde047;
    }

    .icon-preview-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .icon-preview-content strong {
            color: #1e293b;
            font-size: 13px;
            font-weight: bold;
        }

        .icon-preview-content span {
            color: #64748b;
            font-size: 12px;
        }

    /* STATUS BOX */
    .status-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .status-info strong {
        display: block;
        color: #1e293b;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 2px;
    }

    .status-info small {
        color: #64748b;
        font-size: 12px;
    }

    .status-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #1e293b;
        font-size: 14px;
        font-weight: bold;
        white-space: nowrap;
        cursor: pointer;
    }

        .status-toggle input {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #059669;
        }

    /* VALIDATION & ERROR */
    .validation-message {
        color: #dc2626;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .field-error {
        color: #dc2626;
        font-size: 12px;
        font-weight: bold;
        margin-top: 6px;
        display: block;
    }

    /* BUTTONS */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
        margin-top: 10px;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .cancel-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .update-btn {
        background: #d97706;
        color: #ffffff;
        border-color: #b45309;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.25);
    }

        .update-btn:hover {
            background: #b45309;
            border-color: #92400e;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .category-edit-page {
            padding: 15px;
        }

        .edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .status-box {
            align-items: flex-start;
            flex-direction: column;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="category-edit-page">
    <div class="category-edit-container">

        <!-- Header -->
        <div class="edit-header">
            <div class="edit-header-left">
                <div class="edit-header-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Category Management <span>/</span> Edit
                    </div>
                    <h1 class="edit-title">Edit Category</h1>
                    <p class="edit-subtitle">Update and verify existing product category details.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Category")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Categories
            </a>
        </div>

        <!-- Form Card -->
        <div class="edit-card">
            <div class="card-header-custom">
                <div class="card-header-left-group">
                    <div class="card-header-icon">
                        <i class="bi bi-folder-gear"></i>
                    </div>
                    <div class="card-header-text">
                        <h4>Category Information</h4>
                        <p>Modify particulars and system status below.</p>
                    </div>
                </div>
                <span class="required-label">* Required Fields</span>
            </div>

            <div class="form-body">
                <form action="@Url.Action("Edit", "Category", new { id = Model.CategoryId })" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

                    <!-- Category Name -->
                    <div class="form-group-custom">
                        <label asp-for="CategoryName" class="form-label-custom">
                            Category Name <span class="required-star">*</span>
                        </label>
                        <input asp-for="CategoryName"
                               id="categoryNameInput"
                               class="form-control-custom"
                               placeholder="Enter category name"
                               autocomplete="off" />
                        <span asp-validation-for="CategoryName" class="field-error"></span>

                        <!-- Automatic Icon Preview Box -->
                        <div class="icon-preview-box">
                            <div class="icon-preview">
                                <i id="iconPreview" class="bi bi-folder-fill"></i>
                            </div>
                            <div class="icon-preview-content">
                                <strong>Automatic Category Icon</strong>
                                <span id="iconPreviewText">Icon will be selected automatically based on category name.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group-custom">
                        <label asp-for="CategoryDescription" class="form-label-custom">
                            Category Description
                        </label>
                        <textarea asp-for="CategoryDescription"
                                  class="form-control-custom"
                                  rows="4"
                                  placeholder="Enter category description"></textarea>
                        <span asp-validation-for="CategoryDescription" class="field-error"></span>
                    </div>

                    <!-- Status -->
                    <div class="form-group-custom">
                        <div class="status-box">
                            <div class="status-info">
                                <strong>Category Status</strong>
                                <small>Enable or disable this category for product assignments.</small>
                            </div>
                            <label class="status-toggle">
                                <input asp-for="IsAction" type="checkbox" /> Active
                            </label>
                        </div>
                    </div>

                    <!-- Created Date -->
                    <div class="form-group-custom">
                        <label class="form-label-custom">
                            Registration Date
                        </label>
                        <input value="@Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")"
                               class="form-control-custom bg-light"
                               readonly />
                    </div>

                    <!-- Buttons -->
                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Category")" class="btn-custom cancel-btn">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn-custom update-btn">
                            <i class="bi bi-check-circle-fill"></i> Update Category
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryInput = document.getElementById("categoryNameInput");
            const previewIcon = document.getElementById("iconPreview");
            const previewText = document.getElementById("iconPreviewText");

            function getCategoryIcon(categoryName) {
                const name = categoryName.toLowerCase().trim();
                let icon = "bi-folder-fill";
                let text = "General category classification";

                if (name.includes("mobile") || name.includes("phone") || name.includes("smartphone") || name.includes("iphone")) {
                    icon = "bi-phone-fill";
                    text = "Mobile / Smartphone category";
                } else if (name.includes("laptop") || name.includes("computer") || name.includes("pc")) {
                    icon = "bi-laptop-fill";
                    text = "Laptop / Computer category";
                } else if (name.includes("electronic") || name.includes("electronics") || name.includes("tv") || name.includes("television")) {
                    icon = "bi-tv-fill";
                    text = "Electronics category";
                } else if (name.includes("cloth") || name.includes("fashion") || name.includes("dress") || name.includes("garment")) {
                    icon = "bi-person-standing-dress";
                    text = "Clothing & Fashion category";
                } else if (name.includes("shoe") || name.includes("footwear") || name.includes("sandal")) {
                    icon = "bi-person-walking";
                    text = "Footwear & Shoes category";
                } else if (name.includes("grocery") || name.includes("supermarket") || name.includes("shopping")) {
                    icon = "bi-cart-fill";
                    text = "Grocery & Shopping category";
                } else if (name.includes("food") || name.includes("restaurant") || name.includes("hotel") || name.includes("bakery")) {
                    icon = "bi-cup-hot-fill";
                    text = "Food & Restaurant category";
                } else if (name.includes("book") || name.includes("education") || name.includes("school") || name.includes("college")) {
                    icon = "bi-book-fill";
                    text = "Books & Education category";
                } else if (name.includes("software") || name.includes("programming") || name.includes("developer") || name.includes("it ")) {
                    icon = "bi-code-slash";
                    text = "Software & IT category";
                } else if (name.includes("car") || name.includes("auto") || name.includes("automobile") || name.includes("vehicle") || name.includes("bike")) {
                    icon = "bi-car-front-fill";
                    text = "Automobile & Vehicle category";
                } else if (name.includes("company") || name.includes("business") || name.includes("corporate") || name.includes("office")) {
                    icon = "bi-building-fill";
                    text = "Corporate & Business category";
                } else if (name.includes("furniture") || name.includes("home") || name.includes("house")) {
                    icon = "bi-house-fill";
                    text = "Furniture & Home category";
                } else if (name.includes("beauty") || name.includes("cosmetic") || name.includes("salon")) {
                    icon = "bi-stars";
                    text = "Beauty & Cosmetics category";
                } else if (name.includes("medicine") || name.includes("medical") || name.includes("pharmacy") || name.includes("health")) {
                    icon = "bi-heart-pulse-fill";
                    text = "Medical & Healthcare category";
                } else if (name.includes("sport") || name.includes("fitness") || name.includes("gym")) {
                    icon = "bi-trophy-fill";
                    text = "Sports & Fitness category";
                } else if (name.includes("tool") || name.includes("hardware")) {
                    icon = "bi-tools";
                    text = "Tools & Hardware category";
                } else if (name.includes("camera") || name.includes("photography")) {
                    icon = "bi-camera-fill";
                    text = "Camera & Photography category";
                } else if (name.includes("music") || name.includes("audio") || name.includes("song")) {
                    icon = "bi-music-note-beamed";
                    text = "Music & Audio category";
                }

                return { icon: icon, text: text };
            }

            function updateIcon() {
                if (!categoryInput) return;
                const categoryName = categoryInput.value || "";
                const result = getCategoryIcon(categoryName);
                if (previewIcon) previewIcon.className = "bi " + result.icon;
                if (previewText) previewText.textContent = result.text;
            }

            if (categoryInput) {
                categoryInput.addEventListener("input", updateIcon);
                updateIcon();
            }
        });
    </script>
}