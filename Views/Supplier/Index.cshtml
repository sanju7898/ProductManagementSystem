@model IEnumerable<ProductManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Supplier Management";

    var totalSuppliers = Model?.Count() ?? 0;
    var activeSuppliers = Model?.Count(x => x.IsActive) ?? 0;
    var inactiveSuppliers = Model?.Count(x => !x.IsActive) ?? 0;
}

<style>
    .supplier-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .supplier-container {
        max-width: 1500px;
        margin: 0 auto;
    }

    /* =========================
           WORLD-CLASS HEADER
           ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-logo-box {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #9333ea; /* Purple for Supplier match */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(147, 51, 234, 0.4);
        border: 1px solid #7e22ce;
    }

    /* Top Breadcrumb with Dashboard Link */
    .breadcrumb-text {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .dashboard-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #38bdf8;
        text-decoration: none;
        font-weight: bold;
        background: #334155;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #475569;
        transition: all 0.2s;
    }

        .dashboard-link:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #1d4ed8;
            text-decoration: none;
        }

    .breadcrumb-text span {
        color: #64748b;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-heading {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 4px;
        background: #334155;
        border: 1px solid #475569;
        color: #38bdf8;
        font-size: 12px;
        font-weight: bold;
    }

    .page-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .add-supplier-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 48px;
        padding: 0 24px;
        border-radius: 6px;
        background: #2563eb;
        border: 1px solid #1d4ed8;
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.2);
    }

        .add-supplier-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================
           EXECUTIVE SUMMARY CARDS
           ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #334155;
        border-radius: 8px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        transition: transform 0.2s;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.06);
        }

        .summary-card.summary-total {
            border-top-color: #9333ea;
        }

        .summary-card.summary-active {
            border-top-color: #059669;
        }

        .summary-card.summary-inactive {
            border-top-color: #dc2626;
        }

    .summary-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 24px;
    }

    .summary-total .summary-icon {
        background: #faf5ff;
        color: #9333ea;
        border: 1px solid #f3e8ff;
    }

    .summary-active .summary-icon {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .summary-inactive .summary-icon {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .summary-content span {
        display: block;
        color: #1e293b;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 0.3px;
    }

    .summary-content small {
        display: block;
        color: #64748b;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .summary-content strong {
        display: block;
        font-size: 28px;
        font-family: 'Georgia', serif;
        margin-top: 2px;
    }

    .summary-total strong {
        color: #9333ea;
    }

    .summary-active strong {
        color: #059669;
    }

    .summary-inactive strong {
        color: #dc2626;
    }

    /* =========================
           SEARCH CARD
           ========================= */

    .content-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
        margin-bottom: 28px;
    }

    .search-card {
        padding: 22px 28px;
    }

    .search-form {
        display: flex;
        align-items: flex-end;
        gap: 15px;
    }

    .search-field {
        flex: 1;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: bold;
        color: #334155;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .search-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
    }

        .search-input:focus {
            border-color: #9333ea;
            box-shadow: 0 0 0 3px rgba(147, 51, 234, 0.1);
        }

    .search-actions {
        display: flex;
        gap: 10px;
    }

    .search-btn,
    .clear-btn {
        height: 46px;
        padding: 0 22px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .search-btn {
        background: #9333ea;
        color: #ffffff;
        border: 1px solid #7e22ce;
    }

        .search-btn:hover {
            background: #7e22ce;
            color: #ffffff;
        }

    .clear-btn {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde047;
    }

        .clear-btn:hover {
            background: #fef3c7;
            color: #92400e;
            text-decoration: none;
        }

    /* =========================
           TABLE STYLING
           ========================= */

    .table-header {
        padding: 24px 28px;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, #f8fafc 0%, #faf5ff 100%);
    }

    .registry-title-area h4 {
        margin: 0 0 4px;
        color: #7e22ce;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .registry-title-icon {
        width: 36px;
        height: 36px;
        background: #9333ea;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(147, 51, 234, 0.3);
    }

    .registry-title-area p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .record-count {
        padding: 8px 16px;
        border-radius: 6px;
        background: #faf5ff;
        color: #7e22ce;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #f3e8ff;
        box-shadow: 0 2px 4px rgba(147, 51, 234, 0.08);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .supplier-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 1100px;
    }

        .supplier-table thead th {
            background: #334155;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 2px solid #1e293b;
            white-space: nowrap;
        }

        .supplier-table tbody td {
            padding: 18px 20px;
            font-size: 14px;
            color: #1e293b;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .supplier-table tbody tr:hover {
            background: #f8fafc;
        }

    .supplier-id {
        color: #64748b;
        font-weight: bold;
    }

    .supplier-name {
        color: #0f172a;
        font-weight: bold;
        font-size: 15px;
    }

    /* STATUS BADGES */
    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        border: 1px solid transparent;
    }

    .active {
        color: #065f46;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .inactive {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    /* ACTIONS */
    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .btn-action {
        padding: 7px 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid transparent;
        transition: opacity 0.2s;
    }

        .btn-action:hover {
            opacity: 0.85;
            text-decoration: none;
        }

    .btn-details {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .btn-edit {
        background: #fef9c3;
        color: #854d0e;
        border-color: #fde047;
    }

    .btn-delete {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fca5a5;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #faf5ff;
        color: #9333ea;
        font-size: 26px;
        border: 1px solid #f3e8ff;
    }

    .empty-state h5 {
        color: #1e293b;
        font-family: 'Georgia', serif;
        margin: 0 0 8px;
        font-size: 18px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 14px;
        margin: 0 0 20px;
    }

    .empty-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 42px;
        padding: 0 20px;
        border-radius: 6px;
        background: #9333ea;
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        border: 1px solid #7e22ce;
    }

        .empty-add-btn:hover {
            background: #7e22ce;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================
           RAZOR SAFE MEDIA QUERY
           ========================= */

    @@media screen and (max-width: 900px) {
        .supplier-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .search-actions {
            width: 100%;
        }

        .search-btn, .clear-btn {
            flex: 1;
        }
    }
</style>

<div class="supplier-page">
    <div class="supplier-container">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="header-left">
                <div class="header-logo-box">
                    <i class="bi bi-truck-fill"></i>
                </div>
                <div>
                    <!-- Top Breadcrumb with Dashboard Button -->
                    <div class="breadcrumb-text">
                        <a href="@Url.Action("Index", "Dashboard")" class="dashboard-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                        <span>/</span> Supplier Management
                    </div>
                    <div class="title-row">
                        <h1 class="page-heading">Supplier Management</h1>
                        <span class="header-badge">
                            <i class="bi bi-shield-check"></i> Admin
                        </span>
                    </div>
                    <p class="page-description">Manage all vendor partner accounts, contact information, and business profiles</p>
                </div>
            </div>

            <a href="@Url.Action("Create", "Supplier")" class="add-supplier-btn">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add Supplier</span>
            </a>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="summary-grid">
            <div class="summary-card summary-total">
                <div class="summary-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="summary-content">
                    <small>Vendor Directory</small>
                    <span>Total Suppliers</span>
                    <strong>@totalSuppliers</strong>
                </div>
            </div>

            <div class="summary-card summary-active">
                <div class="summary-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="summary-content">
                    <small>Operational Partners</small>
                    <span>Active Suppliers</span>
                    <strong>@activeSuppliers</strong>
                </div>
            </div>

            <div class="summary-card summary-inactive">
                <div class="summary-icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div class="summary-content">
                    <small>Dormant Accounts</small>
                    <span>Inactive Suppliers</span>
                    <strong>@inactiveSuppliers</strong>
                </div>
            </div>
        </div>

        <!-- SEARCH CARD -->
        <div class="content-card search-card">
            <form action="@Url.Action("Index", "Supplier")" method="get">
                <div class="search-form">
                    <div class="search-field">
                        <label class="form-label">Search Records</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="search-input"
                               placeholder="Filter by supplier name, phone or email..." />
                    </div>
                    <div class="search-actions">
                        <button type="submit" class="search-btn">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a href="@Url.Action("Index", "Supplier")" class="clear-btn">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- SUPPLIER RECORDS TABLE -->
        <div class="content-card table-card">
            <div class="table-header">
                <div class="registry-title-area">
                    <h4>
                        <span class="registry-title-icon"><i class="bi bi-folder2-open"></i></span>
                        Registry Records
                    </h4>
                    <p>Complete official directory of registered supplier vendor accounts</p>
                </div>
                <span class="record-count">
                    <i class="bi bi-database-fill me-1"></i> @totalSuppliers @(totalSuppliers == 1 ? "Record" : "Records")
                </span>
            </div>

            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="supplier-table">
                        <thead>
                            <tr>
                                <th>Supplier ID</th>
                                <th>Supplier Name</th>
                                <th>Email Address</th>
                                <th>Phone Number</th>
                                <th>Office Address</th>
                                <th>Status</th>
                                <th>Registration Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="supplier-id">#@item.SupplierId</span>
                                    </td>
                                    <td>
                                        <span class="supplier-name">@item.SupplierName</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-envelope me-1 text-secondary"></i> @(item.Email ?? "-")
                                    </td>
                                    <td>
                                        <i class="bi bi-telephone me-1 text-secondary"></i> @item.Phone
                                    </td>
                                    <td>
                                        @(item.Address ?? "-")
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status active">
                                                <i class="bi bi-check-circle-fill"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status inactive">
                                                <i class="bi bi-x-circle-fill"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @item.CreatedDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="@Url.Action("Details", "Supplier", new { id = item.SupplierId })" class="btn-action btn-details" title="View Details">
                                                <i class="bi bi-eye-fill"></i> <span>View</span>
                                            </a>
                                            <a href="@Url.Action("Edit", "Supplier", new { id = item.SupplierId })" class="btn-action btn-edit" title="Edit Supplier">
                                                <i class="bi bi-pencil-square"></i> <span>Edit</span>
                                            </a>
                                            <a href="@Url.Action("Delete", "Supplier", new { id = item.SupplierId })" class="btn-action btn-delete" title="Delete Supplier">
                                                <i class="bi bi-trash-fill"></i> <span>Delete</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-truck"></i>
                        </div>
                        <h5>No Supplier Records Found</h5>
                        <p>There are no supplier partner accounts matching your filter criteria.</p>
                        <a href="@Url.Action("Create", "Supplier")" class="empty-add-btn">
                            <i class="bi bi-plus-circle-fill"></i> Register New Supplier
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>
</div>