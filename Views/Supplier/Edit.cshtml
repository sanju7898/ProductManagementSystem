@model ProductManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
}

<style>
    .supplier-edit-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .supplier-edit-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .edit-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .edit-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #d97706; /* Amber for Edit match */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.4);
        border: 1px solid #b45309;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .edit-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .edit-subtitle {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           FORM CARD WITH AMBER TOP ACCENT
           ========================= */

    .edit-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #d97706;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #fef3c7 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-left-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #d97706;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(217, 119, 6, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #78350f;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .required-label {
        font-size: 12px;
        color: #dc2626;
        font-weight: bold;
    }

    .form-body {
        padding: 32px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group-custom {
        margin-bottom: 20px;
    }

        .form-group-custom.full-width {
            grid-column: 1 / -1;
        }

    .form-label-custom {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .required-star {
        color: #dc2626;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1px solid #94a3b8;
        border-radius: 6px;
        outline: none;
        font-size: 14px;
        color: #0f172a;
        background: #ffffff;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #d97706;
            box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.1);
        }

    textarea.form-control-custom {
        height: auto;
        padding: 14px 16px;
        resize: vertical;
    }

    /* VALIDATION & ERROR */
    .validation-message {
        color: #dc2626;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .field-error {
        color: #dc2626;
        font-size: 12px;
        font-weight: bold;
        margin-top: 6px;
        display: block;
    }

    /* BUTTONS */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        margin-top: 10px;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .cancel-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .update-btn {
        background: #d97706;
        color: #ffffff;
        border-color: #b45309;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.25);
    }

        .update-btn:hover {
            background: #b45309;
            border-color: #92400e;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .supplier-edit-page {
            padding: 15px;
        }

        .edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="supplier-edit-page">
    <div class="supplier-edit-container">

        <!-- Header -->
        <div class="edit-header">
            <div class="edit-header-left">
                <div class="edit-header-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Supplier Management <span>/</span> Edit
                    </div>
                    <h1 class="edit-title">Edit Supplier</h1>
                    <p class="edit-subtitle">Update vendor partner profile and office details securely.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Supplier")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Suppliers
            </a>
        </div>

        <!-- Form Card -->
        <div class="edit-card">
            <div class="card-header-custom">
                <div class="card-header-left-group">
                    <div class="card-header-icon">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="card-header-text">
                        <h4>Supplier Information (#@Model.SupplierId)</h4>
                        <p>Modify partner credentials and contact parameters below.</p>
                    </div>
                </div>
                <span class="required-label">* Required Fields</span>
            </div>

            <div class="form-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="SupplierId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="IsActive" />

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

                    <div class="form-grid">

                        <!-- Supplier Name -->
                        <div class="form-group-custom">
                            <label asp-for="SupplierName" class="form-label-custom">
                                Supplier Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="SupplierName"
                                   class="form-control-custom"
                                   placeholder="Enter supplier name"
                                   autocomplete="off" />
                            <span asp-validation-for="SupplierName" class="field-error"></span>
                        </div>

                        <!-- Email -->
                        <div class="form-group-custom">
                            <label asp-for="Email" class="form-label-custom">
                                Email Address <span class="required-star">*</span>
                            </label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control-custom"
                                   placeholder="Enter email address"
                                   autocomplete="off" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <!-- Phone -->
                        <div class="form-group-custom full-width">
                            <label asp-for="Phone" class="form-label-custom">
                                Phone Number <span class="required-star">*</span>
                            </label>
                            <input asp-for="Phone"
                                   class="form-control-custom"
                                   placeholder="Enter contact phone number"
                                   autocomplete="off" />
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>

                        <!-- Address -->
                        <div class="form-group-custom full-width">
                            <label asp-for="Address" class="form-label-custom">
                                Office Address
                            </label>
                            <textarea asp-for="Address"
                                      class="form-control-custom"
                                      rows="4"
                                      placeholder="Enter complete supplier location or office address..."></textarea>
                            <span asp-validation-for="Address" class="field-error"></span>
                        </div>

                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("Index", "Supplier")" class="btn-custom cancel-btn">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn-custom update-btn">
                            <i class="bi bi-check-circle-fill"></i> Update Supplier
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}