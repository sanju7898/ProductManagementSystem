@model ProductManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<style>
    .supplier-details-page {
        background: #eef2f5;
        min-height: 90vh;
        padding: 40px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .supplier-details-container {
        max-width: 950px;
        margin: 0 auto;
    }

    /* =========================
           CLASSIC HEADER WITH LOGO BOX
           ========================= */

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding: 28px 32px;
        background: #1e293b;
        border: 1px solid #0f172a;
        border-radius: 8px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    }

    .details-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .details-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb; /* Blue for Details */
        color: #ffffff;
        font-size: 28px;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
        border: 1px solid #1d4ed8;
    }

    .breadcrumb-text {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 4px;
    }

        .breadcrumb-text span {
            margin: 0 6px;
            color: #64748b;
        }

    .details-title {
        margin: 0;
        color: #ffffff;
        font-family: 'Georgia', serif;
        font-size: 28px;
        font-weight: bold;
    }

    .details-description {
        margin: 5px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* Colorful Back Button */
    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 20px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.08);
    }

        .back-btn:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    /* =========================
           DETAILS CARD WITH TOP ACCENT
           ========================= */

    .details-card {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-top: 4px solid #2563eb;
        border-radius: 8px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    /* =========================
           COLORFUL & CLASSIC CARD HEADER
           ========================= */

    .card-header-custom {
        padding: 22px 28px;
        border-bottom: 1px solid #cbd5e1;
        background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .card-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 2px 5px rgba(37, 99, 235, 0.3);
    }

    .card-header-text h4 {
        margin: 0 0 2px;
        color: #1e3a8a;
        font-size: 18px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .card-header-text p {
        margin: 0;
        color: #475569;
        font-size: 13px;
        font-weight: 500;
    }

    .details-body {
        padding: 32px 28px;
    }

    .supplier-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        margin-bottom: 24px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

    .supplier-avatar {
        width: 56px;
        height: 56px;
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #faf5ff;
        color: #9333ea;
        font-size: 24px;
        border: 1px solid #f3e8ff;
    }

    .supplier-profile-info h3 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 20px;
        font-family: 'Georgia', serif;
        font-weight: bold;
    }

    .supplier-profile-info p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        font-weight: bold;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .detail-item {
        padding: 18px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
    }

        .detail-item.full-width {
            grid-column: 1 / -1;
        }

    .detail-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .detail-label i {
            color: #2563eb;
            font-size: 14px;
        }

    .detail-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: bold;
        word-break: break-word;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        border: 1px solid transparent;
    }

    .status-active {
        color: #065f46;
        background: #d1fae5;
        border-color: #a7f3d0;
    }

    .status-inactive {
        color: #991b1b;
        background: #fee2e2;
        border-color: #fecaca;
    }

    /* ACTION BUTTONS */
    .details-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-custom {
        height: 46px;
        padding: 0 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-back {
        background: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

        .btn-back:hover {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

    .btn-edit {
        background: #d97706; /* Amber for Edit match */
        color: #ffffff;
        border-color: #b45309;
        box-shadow: 0 3px 8px rgba(217, 119, 6, 0.25);
    }

        .btn-edit:hover {
            background: #b45309;
            color: #ffffff;
            text-decoration: none;
        }

    @@media screen and (max-width: 700px) {
        .supplier-details-page {
            padding: 15px;
        }

        .details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .back-btn {
            width: 100%;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .details-actions {
            flex-direction: column;
        }

        .btn-custom {
            width: 100%;
        }

        .supplier-profile {
            align-items: flex-start;
        }
    }
</style>

<div class="supplier-details-page">
    <div class="supplier-details-container">

        <!-- Header -->
        <div class="details-header">
            <div class="details-header-left">
                <div class="details-header-icon">
                    <i class="bi bi-truck-fill"></i>
                </div>
                <div>
                    <div class="breadcrumb-text">
                        Dashboard <span>/</span> Supplier Management <span>/</span> Details
                    </div>
                    <h1 class="details-title">Supplier Details</h1>
                    <p class="details-description">View complete verified profile and credentials for this vendor partner.</p>
                </div>
            </div>

            <a href="@Url.Action("Index", "Supplier")" class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Suppliers
            </a>
        </div>

        <!-- Details Card -->
        <div class="details-card">
            <div class="card-header-custom">
                <div class="card-header-icon">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div class="card-header-text">
                    <h4>Vendor Overview</h4>
                    <p>Detailed breakdown of supplier contact details and registry metadata.</p>
                </div>
            </div>

            <div class="details-body">

                <!-- Supplier Profile -->
                <div class="supplier-profile">
                    <div class="supplier-avatar">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="supplier-profile-info">
                        <h3>@Model.SupplierName</h3>
                        <p>Supplier ID: #@Model.SupplierId</p>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="details-grid">

                    <!-- Supplier ID -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-hash"></i> Supplier ID
                        </div>
                        <div class="detail-value">
                            #@Model.SupplierId
                        </div>
                    </div>

                    <!-- Supplier Name -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-tag-fill"></i> Supplier Name
                        </div>
                        <div class="detail-value">
                            @Model.SupplierName
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-envelope-fill"></i> Email Address
                        </div>
                        <div class="detail-value">
                            @(Model.Email ?? "-")
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-telephone-fill"></i> Phone Number
                        </div>
                        <div class="detail-value">
                            @Model.Phone
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="detail-item full-width">
                        <div class="detail-label">
                            <i class="bi bi-geo-alt-fill"></i> Office Address
                        </div>
                        <div class="detail-value">
                            @(Model.Address ?? "-")
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-toggle-on"></i> Partner Status
                        </div>
                        <div class="detail-value">
                            @if (Model.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-check-circle-fill"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="bi bi-x-circle-fill"></i> Inactive
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Products Count -->
                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-boxes"></i> Associated Products
                        </div>
                        <div class="detail-value" style="color: #9333ea;">
                            @(Model.Products?.Count ?? 0) Products Supplied
                        </div>
                    </div>

                    <!-- Created Date -->
                    <div class="detail-item full-width">
                        <div class="detail-label">
                            <i class="bi bi-calendar3"></i> Registration Date
                        </div>
                        <div class="detail-value">
                            @Model.CreatedDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                </div>

                <!-- Actions -->
                <div class="details-actions">
                    <a href="@Url.Action("Index", "Supplier")" class="btn-custom btn-back">
                        <i class="bi bi-list"></i> Return to Registry
                    </a>
                    <a href="@Url.Action("Edit", "Supplier", new { id = Model.SupplierId })" class="btn-custom btn-edit">
                        <i class="bi bi-pencil-square"></i> Edit Supplier
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>